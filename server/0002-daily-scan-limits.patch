+        self.ash, self.misty = self.world.ash, self.world.misty
+        self.provider_calls = 0
+        self.provider_error = None
+
+    # --- helpers ------------------------------------------------------------------------------------------------------
+
+    def job(self, user, positions=(0,), batch=False):
+        now = datetime.datetime.utcnow()
+        job = ScanJob(user_id=user.id, status="pending", created_at=now, updated_at=now, expires_at=now + datetime.timedelta(days=14))
+        self.db.add(job)
+        self.db.flush()
+        if self.db.get(ScanQueueUserState, user.id) is None:
+            self.db.add(ScanQueueUserState(user_id=user.id))
+        for position in positions:
+            path = Path(self.temp_dir.name) / str(job.id) / f"{position}.jpg"
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(b"photo")
+            self.db.add(ScanJobItem(
+                job_id=job.id, user_id=user.id, position=position, image_path=f"{job.id}/{position}.jpg",
+                content_type="image/jpeg", byte_size=5, status="pending", resolved=False, attempts=0,
+                transient_failures=0, next_attempt_at=now, created_at=now, updated_at=now, batch_mode=batch,
+            ))
+        self.db.commit()
+        return job
+
+    def used(self, user):
+        self.db.expire_all()
+        return limits.used_on(self.db, user.id, self.clock.now.date())
+
+    def item(self, item_id):
+        self.db.expire_all()
+        return self.db.get(ScanJobItem, item_id)
+
+    def make_ready(self, item_id):
