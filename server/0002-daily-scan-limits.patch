diff --git a/frontend/src/utils/scanLimits.js b/frontend/src/utils/scanLimits.js
new file mode 100644
index 0000000..5fc591d
--- /dev/null
+++ b/frontend/src/utils/scanLimits.js
@@ -0,0 +1,53 @@
+// Daily scan limits (docs/SCAN_LIMITS.md): the small rules the admin screens share, kept out of the components so they can be
+// tested on their own.
+
+// The most the server accepts for a daily limit. Anything above is refused there too.
+export const MAX_DAILY_SCAN_LIMIT = 100000
+
+// What the number box offers before anybody has chosen a limit.
+export const SUGGESTED_SCAN_LIMIT = 100
+
+export const SCAN_LIMIT_MODES = ['default', 'custom', 'unlimited']
+
+// A whole number from 0 to MAX_DAILY_SCAN_LIMIT from what was typed, or null when it is not one. 0 is allowed: it switches
+// scanning off.
+export function parseScanLimit(text) {
+  const typed = String(text ?? '').trim()
+  if (!/^\d+$/.test(typed)) return null
+  const value = Number(typed)
+  return value <= MAX_DAILY_SCAN_LIMIT ? value : null
+}
+
+// What one user has used today, the way the Users list shows it: "34 / 100 today", or "34 today · Unlimited" without a limit.
+export function formatScanUsage(row, words) {
+  if (!row) return ''
+  const used = Number(row.used) || 0
+  if (row.unlimited || row.daily_limit == null) return `${used} ${words.today} · ${words.unlimited}`
+  return `${used} / ${row.daily_limit} ${words.today}`
+}
+
+// The number a user's box starts with: their own if they have one, else the limit that applies, else the suggestion.
+export function startingLimit(row) {
+  const known = row?.custom_limit ?? row?.daily_limit
+  return String(known ?? SUGGESTED_SCAN_LIMIT)
+}
+
+// The UTC offset the server sent ("+02:00") as it is written next to a zone name: "UTC+02:00".
+export function utcLabel(offset) {
+  return offset ? `UTC${offset}` : ''
+}
+
+// What an admin sees under "Resets": "Europe/Berlin (UTC+02:00)", and the zone alone when no offset came.
+export function zoneLabel(settings) {
+  if (!settings?.timezone) return ''
+  const offset = utcLabel(settings.utc_offset)
+  return offset ? `${settings.timezone} (${offset})` : settings.timezone
+}
+
+// The body to send for a change of the default. Only what changed is sent, so saving the number never flips the switch back.
+export function defaultLimitChange(current, draft) {
+  const change = {}
+  if (draft.unlimited !== current.default_unlimited) change.default_unlimited = draft.unlimited
+  if (draft.limit != null && draft.limit !== current.default_limit) change.default_limit = draft.limit
+  return change
+}
diff --git a/frontend/src/utils/scanLimits.test.js b/frontend/src/utils/scanLimits.test.js
