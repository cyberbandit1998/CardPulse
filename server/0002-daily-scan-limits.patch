+"""Daily scan limits: what the signed-in user has left today, and the administrator's controls over it.
+
+The rules (what counts as a scan, when a day starts, which limit a user has) are in services/scan_limits.py and, written out
+for people, in docs/SCAN_LIMITS.md. Enforcement is not here: it happens where the vision model is asked (api/recognize.py and
+services/scan_queue.py), so no request can read a card without it. This module only reports the numbers and lets an admin
+change the limits.
+"""
+
+from typing import Literal, Optional
+
+from fastapi import APIRouter, Depends, HTTPException, Response
+from pydantic import BaseModel, Field, model_validator
+from sqlalchemy.orm import Session
+
+from api.auth import get_current_user
+from database import get_db
+from models import User
+from services import scan_limits as limits
+
+
+def _private_response(response: Response) -> None:
+    """These numbers are one user's own: a shared cache must not keep them."""
+    response.headers["Cache-Control"] = "private, no-store"
+
+
+router = APIRouter(dependencies=[Depends(_private_response)])
+
+
+def require_admin(current_user: User = Depends(get_current_user)) -> User:
+    if current_user.role != "admin":
+        raise HTTPException(status_code=403, detail="Admin access required")
+    return current_user
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Every signed-in user: what is left today
+# ---------------------------------------------------------------------------------------------------------------------
+
+@router.get("/me")
+def my_scan_allowance(db: Session = Depends(get_db), current_user: User = Depends(get_current_user)):
+    """The user's limit for today (``null`` is unlimited), what they have used, what is left and when it starts over."""
+    return limits.current_allowance(db, current_user.id).payload()
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Administrators: the default, and each user's own setting
+# ---------------------------------------------------------------------------------------------------------------------
+
+class DefaultLimitRequest(BaseModel):
+    default_unlimited: Optional[bool] = None
+    default_limit: Optional[int] = Field(default=None, ge=0, le=limits.MAX_DAILY_LIMIT)
+
+    @model_validator(mode="after")
+    def something_to_change(self):
+        if self.default_unlimited is None and self.default_limit is None:
+            raise ValueError("Send default_unlimited, default_limit or both.")
+        return self
+
+
+class UserLimitRequest(BaseModel):
+    mode: Literal["default", "custom", "unlimited"]
+    # The number of a custom limit. With "unlimited" it is only remembered, for when the user is given a limit again.
+    limit: Optional[int] = Field(default=None, ge=0, le=limits.MAX_DAILY_LIMIT)
+
+    @model_validator(mode="after")
+    def a_custom_limit_needs_a_number(self):
+        if self.mode == "custom" and self.limit is None:
+            raise ValueError("A custom limit needs a number: send limit.")
+        return self
+
+
+@router.get("/settings")
+def get_default_limit(db: Session = Depends(get_db), admin: User = Depends(require_admin)):
+    """The default limit and the time zone and moment the day starts over (Settings → Scanner)."""
+    return limits.settings_payload(db)
+
+
+@router.put("/settings")
+def put_default_limit(
+    data: DefaultLimitRequest,
+    db: Session = Depends(get_db),
+    admin: User = Depends(require_admin),
+):
+    limits.set_default_limit(db, unlimited=data.default_unlimited, limit=data.default_limit)
+    db.commit()
+    return limits.settings_payload(db)
+
+
+@router.get("/users")
+def get_user_limits(db: Session = Depends(get_db), admin: User = Depends(require_admin)):
+    """Every user with their setting (default, custom or unlimited), the limit that applies and today's usage."""
+    return {**limits.settings_payload(db), "users": limits.users_overview(db)}
+
+
+@router.put("/users/{user_id}")
+def put_user_limit(
+    user_id: int,
+    data: UserLimitRequest,
+    db: Session = Depends(get_db),
+    admin: User = Depends(require_admin),
+):
+    if db.get(User, user_id) is None:
+        raise HTTPException(status_code=404, detail="User not found")
+    limits.set_user_limit(db, user_id, data.mode, data.limit)
+    db.commit()
+    return limits.user_overview(db, user_id)
