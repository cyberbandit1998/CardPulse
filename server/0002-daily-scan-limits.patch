+  providers: [{
+    id: 'gemini', label: 'Gemini', models: ['gemini-flash-latest'], default_model: 'gemini-flash-latest',
+    selected_model: 'gemini-flash-latest', request_timeout_seconds: 30, requires_api_key: true, api_key_configured: true,
+    endpoint_type: 'hosted', key_help_url: null, setup_help_url: null, custom_model_allowed: false, custom_model: '',
+  }],
+}
+
+function nextMidnight() {
+  const next = new Date()
+  next.setHours(24, 0, 0, 0)
+  return next
+}
+
+async function installApi(page, signedIn = ADMIN) {
+  await page.addInitScript(user => {
+    localStorage.setItem('token', 'scan-limits-token')
+    localStorage.setItem('user', JSON.stringify(user))
+    localStorage.setItem('app_language', 'en')
+  }, signedIn)
+
+  const reset = nextMidnight()
+  let settings = {
+    default_unlimited: true,
+    default_limit: 100,
+    timezone: 'Europe/Berlin',
+    utc_offset: '+02:00',
+    reset_time: '00:00',
+    next_reset_at: reset.toISOString(),
+    seconds_until_reset: Math.round((reset - new Date()) / 1000),
+  }
+  const people = [
+    { id: 1, username: 'oak', role: 'admin', is_active: true, avatar_id: null, created_at: '2026-01-01' },
+    { id: 2, username: 'ash', role: 'trainer', is_active: true, avatar_id: null, created_at: '2026-01-02' },
+    { id: 3, username: 'misty', role: 'trainer', is_active: true, avatar_id: null, created_at: '2026-01-03' },
+  ]
+  const used = { 1: 12, 2: 34, 3: 0 }
+  const overrides = {} // user id -> {unlimited, custom_limit}
+  const writes = { settings: [], users: [] }
+
+  const row = (person) => {
+    const own = overrides[person.id]
+    const defaultLimit = settings.default_unlimited ? null : settings.default_limit
+    const mode = own ? (own.unlimited ? 'unlimited' : 'custom') : 'default'
+    const limit = !own ? defaultLimit : own.unlimited ? null : own.custom_limit
+    return {
+      id: person.id, username: person.username, role: person.role, is_active: true,
+      mode, custom_limit: own?.custom_limit ?? null, daily_limit: limit, unlimited: limit === null,
+      used: used[person.id], remaining: limit === null ? null : Math.max(0, limit - used[person.id]),
+    }
+  }
+
+  await page.route('**/api/**', async route => {
+    const request = route.request()
+    const path = new URL(request.url()).pathname
+    const method = request.method()
+    if (!path.startsWith('/api/')) return route.continue()
+    if (path === '/api/auth/mode') return route.fulfill({ json: { multi_user: true, locked: false } })
+    if (path === '/api/auth/me') return route.fulfill({ json: signedIn })
+    if (path === '/api/auth/users') return route.fulfill({ json: people })
+    if (path === '/api/settings/scanner') return route.fulfill({ json: scannerConfiguration })
+    if (path === '/api/settings/') {
+      return route.fulfill({ json: {
+        language: 'en', currency: 'EUR', price_primary: 'trend', price_display: '["trend"]',
+        scan_diagnostics_available: 'false', scan_diagnostics_deletion_available: 'false', scanner_gemini_fallback: 'false',
+      } })
+    }
+    if (path === '/api/scan-limits/settings') {
+      if (signedIn.role !== 'admin') return route.fulfill({ status: 403, json: { detail: 'Admin access required' } })
+      if (method === 'PUT') {
+        const body = request.postDataJSON()
+        writes.settings.push(body)
+        settings = { ...settings, ...body }
+      }
+      return route.fulfill({ json: settings })
+    }
+    if (path === '/api/scan-limits/users') {
+      if (signedIn.role !== 'admin') return route.fulfill({ status: 403, json: { detail: 'Admin access required' } })
+      return route.fulfill({ json: { ...settings, users: people.map(row) } })
+    }
+    const single = path.match(/^\/api\/scan-limits\/users\/(\d+)$/)
+    if (single && method === 'PUT') {
+      const id = Number(single[1])
+      const body = request.postDataJSON()
+      writes.users.push({ id, ...body })
+      if (body.mode === 'default') delete overrides[id]
+      else if (body.mode === 'custom') overrides[id] = { unlimited: false, custom_limit: body.limit }
+      else overrides[id] = { unlimited: true, custom_limit: overrides[id]?.custom_limit ?? null }
+      return route.fulfill({ json: row(people.find(person => person.id === id)) })
+    }
+    if (path === '/api/settings/exchange-rate') return route.fulfill({ json: { rate: 1 } })
+    if (path === '/api/settings/tcgdex-filter-languages') return route.fulfill({ json: { languages: [{ code: 'en', name: 'English' }] } })
+    if (path === '/api/sets/' || path === '/api/cards/custom') return route.fulfill({ json: [] })
+    if (path === '/api/cards/recognize/jobs') return route.fulfill({ json: { jobs: [] } })
+    if (path === '/api/profile/') return route.fulfill({ json: { is_profile_public: false, public_show_values: false } })
+    if (path === '/api/sync/status') return route.fulfill({ json: { is_running: false, is_price_sync_running: false } })
+    if (path.includes('contributors') || path.includes('supporters') || path.includes('custom-matches')) {
+      return route.fulfill({ json: [] })
+    }
+    if (path.includes('donations')) return route.fulfill({ json: { total: 0, donations: [] } })
+    return route.fulfill({ json: {} })
+  })
+  return { writes }
+}
+
+const noHorizontalOverflow = page => page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth)
+
