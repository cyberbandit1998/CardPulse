new file mode 100644
index 0000000..c19626e
--- /dev/null
+++ b/backend/tests/test_scan_limits.py
@@ -0,0 +1,631 @@
+"""Daily scan limits, the rules themselves (services/scan_limits.py): who may scan how much, how a day is counted and when it
+starts over. The same rules through the HTTP API, the direct scan and the queue are in test_scan_limits_http.py."""
+
+import datetime
+import os
+import threading
+import unittest
+from unittest.mock import patch
+
+try:
+    from sqlalchemy.exc import IntegrityError
+
+    from models import ScanItemCharge, ScanLimitOverride, ScanUsage, Setting
+    from services import scan_limits as limits
+
+    from scan_limits_world import Clock, ScanLimitsWorld
+
+    DEPS = True
+except ModuleNotFoundError as error:  # pragma: no cover - lightweight environments
+    if error.name == "scan_limits_world":
+        raise
+    DEPS = False
+
+DAY = datetime.date(2026, 10, 9)
+
+
+@unittest.skipUnless(DEPS, "SQLAlchemy is not installed in this lightweight test environment")
+class ScanLimitRulesTests(unittest.TestCase):
+    def setUp(self):
+        self.world = ScanLimitsWorld()
+        self.addCleanup(self.world.close)
+        self.db = self.world.db
+        self.clock = Clock(self, "Europe/Berlin")
+        self.clock.at(2026, 10, 9, 12, 0)
+        self.ash, self.misty, self.oak = self.world.ash, self.world.misty, self.world.oak
+
+    # --- helpers ------------------------------------------------------------------------------------------------------
+
+    def set_default(self, limit=None, unlimited=False):
+        limits.set_default_limit(self.db, unlimited=unlimited, limit=limit)
+        self.db.commit()
+
+    def set_user(self, user, mode, limit=None):
+        limits.set_user_limit(self.db, user.id, mode, limit)
+        self.db.commit()
+
+    def charge(self, user, **kwargs):
+        return limits.charge_scans(self.db, user.id, **kwargs)
+
+    def allowance(self, user):
+        return limits.current_allowance(self.db, user.id)
+
+    def charge_until_refused(self, user, cap=1000):
+        done = 0
+        while done < cap:
+            try:
+                self.charge(user)
+            except limits.ScanLimitReached:
+                return done
+            done += 1
+        return done
+
+    # --- nothing changes until an administrator chooses --------------------------------------------------------------
+
+    def test_nobody_is_limited_until_an_administrator_chooses_a_number(self):
+        allowance = self.allowance(self.ash)
+        self.assertTrue(allowance.unlimited)
+        self.assertIsNone(allowance.daily_limit)
+        self.assertIsNone(allowance.remaining)
+        self.assertFalse(allowance.exhausted)
+        self.assertEqual(self.charge_until_refused(self.ash, cap=50), 50)
+        self.assertEqual(self.allowance(self.ash).used, 50)  # still counted, so the admin page can show it
+
+    def test_the_default_starts_unlimited_with_a_number_to_offer(self):
+        self.assertEqual(limits.default_limit(self.db), (True, limits.SUGGESTED_DEFAULT_LIMIT))
+
+    # --- the default limit --------------------------------------------------------------------------------------------
+
+    def test_scans_are_counted_up_to_the_limit_and_the_next_one_is_refused(self):
+        self.set_default(limit=3)
+
+        self.assertEqual(self.charge_until_refused(self.ash), 3)
+
+        allowance = self.allowance(self.ash)
+        self.assertEqual((allowance.daily_limit, allowance.used, allowance.remaining), (3, 3, 0))
+        self.assertTrue(allowance.exhausted)
+        with self.assertRaises(limits.ScanLimitReached):
+            self.charge(self.ash)
+        self.assertEqual(self.allowance(self.ash).used, 3)  # a refused scan is not counted
+
+    def test_used_and_remaining_follow_every_scan(self):
+        self.set_default(limit=5)
+        seen = []
+        for _ in range(5):
+            allowance = self.charge(self.ash)
+            seen.append((allowance.used, allowance.remaining))
+        self.assertEqual(seen, [(1, 4), (2, 3), (3, 2), (4, 1), (5, 0)])
+
+    def test_a_refusal_says_what_was_asked_in_numbers(self):
+        self.set_default(limit=2)
+        self.charge(self.ash, count=2)
+
+        with self.assertRaises(limits.ScanLimitReached) as caught:
+            self.charge(self.ash)
+
+        body = caught.exception.body()
+        self.assertEqual(caught.exception.status_code, 429)
+        self.assertEqual(body["code"], "scan_limit_reached")
+        self.assertTrue(body["detail"].startswith("Daily scan limit reached"))
+        self.assertEqual((body["daily_limit"], body["used"], body["remaining"], body["unlimited"]), (2, 2, 0, False))
+        self.assertEqual(body["resets_at"], "2026-10-10T00:00:00+02:00")
+        self.assertEqual(body["resets_in_seconds"], 12 * 3600)
+        self.assertEqual(body["timezone"], "Europe/Berlin")
+        self.assertEqual(caught.exception.headers["Retry-After"], str(12 * 3600))
+
+    def test_a_group_is_counted_all_or_nothing(self):
+        self.set_default(limit=3)
+        self.charge(self.ash, count=2)
+
+        with self.assertRaises(limits.ScanLimitReached):
+            self.charge(self.ash, count=2)  # one is left, two are needed
+
+        self.assertEqual(self.allowance(self.ash).used, 2)
+        self.charge(self.ash, count=1)  # the one that was left is still there
+        self.assertEqual(self.allowance(self.ash).used, 3)
+
