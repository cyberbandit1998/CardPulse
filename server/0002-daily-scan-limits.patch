+    await card.getByRole('button', { name: 'Unlimited by default' }).click()
+    await expect(card.getByLabel('Default daily scan limit')).toBeEnabled()
+    await card.getByLabel('Default daily scan limit').fill('50')
+    await card.getByRole('button', { name: 'Save' }).click()
