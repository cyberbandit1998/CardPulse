+        app.dependency_overrides[get_db] = override_db
+        # multi_user_enabled() reads the stored setting through its own session; serve it from here instead.
+        patcher = patch.object(auth_api, "get_setting", lambda key, default=None: {"multi_user_mode": "true"}.get(key, default))
