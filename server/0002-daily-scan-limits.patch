diff --git a/backend/services/scan_limits.py b/backend/services/scan_limits.py
new file mode 100644
index 0000000..e38da90
--- /dev/null
+++ b/backend/services/scan_limits.py
@@ -0,0 +1,410 @@
+"""Daily scan limits: how many cards each user may have read by the vision model in a day.
+
+One *scan* is one photo whose card the vision model is asked to read, whichever provider reads it (Gemini, or an
+OpenAI-compatible endpoint such as Groq). The limit is kept and checked here, on the server, immediately before the model is
+asked, so a client that ignores it, or an older app, gets nothing that the website would not give it.
+
+What counts
+
+* Counted: a photo at the moment its recognition starts (the first request to the model), once, however the read turns out.
+* Not counted: opening the scanner or the camera, a photo the server turns away before it reads anything (too big, not an
+  image, nobody signed in, no API key set up), matching a card that was read with the catalogue, the checks the server makes
+  with the model's help afterwards (comparing pictures, the optional second opinion from Gemini), and the retries the queue
+  makes by itself when the model or the network fails.
+* Counted again: a photo whose owner asks for it to be read again (Retry), because that is another request to the model.
+
+When a day starts
+
+The day is the server's local date, so a new day starts at the server's local midnight. In Docker that is the container's
+time zone, which is UTC unless TZ is set (see docs/SCAN_LIMITS.md). Usage is stored in the database, so a restart of the
+backend loses nothing; a new day needs no job to run, because it is a new row that starts at zero.
+
+Which limit a user has
+
+A user's own setting wins (``ScanLimitOverride``): a number of their own, or unlimited. A user without one has the default,
+which is a number or unlimited, and is unlimited until an administrator chooses a number, so installing this changes nothing by
+itself. Admins are limited like everyone else until they are set to unlimited.
+"""
+
+from __future__ import annotations
+
+import datetime
+import os
+import time
+from dataclasses import dataclass
+from typing import Iterable, Optional
+
+from fastapi import HTTPException
+from fastapi.responses import JSONResponse
+from sqlalchemy import update
+from sqlalchemy.dialects import postgresql, sqlite
+from sqlalchemy.orm import Session
+from sqlalchemy.sql import func
+
+from models import ScanItemCharge, ScanLimitOverride, ScanUsage, Setting, User
+
+# The administrator's choice for everyone who has no limit of their own, kept with the other global settings.
+DEFAULT_UNLIMITED_SETTING = "scan_limit_default_unlimited"
+DEFAULT_LIMIT_SETTING = "scan_limit_default"
+
+# What the admin page offers as the number before anyone has chosen one (it is not applied while the default is unlimited).
+SUGGESTED_DEFAULT_LIMIT = 100
+MAX_DAILY_LIMIT = 100_000
+
+MODE_DEFAULT = "default"
+MODE_CUSTOM = "custom"
+MODE_UNLIMITED = "unlimited"
+MODES = (MODE_DEFAULT, MODE_CUSTOM, MODE_UNLIMITED)
+
+LIMIT_REACHED_CODE = "scan_limit_reached"
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Time: the server's local day
+# ---------------------------------------------------------------------------------------------------------------------
+
+def now() -> datetime.datetime:
+    """The current time in the server's own time zone. The one clock everything here reads, so tests can move it."""
+    return datetime.datetime.now().astimezone()
+
+
+def next_reset(moment: datetime.datetime) -> datetime.datetime:
+    """The next local midnight after ``moment``, with the offset that is in force then.
+
+    The C library works out the offset (``mktime`` with an unknown daylight-saving flag), so a change of the clocks between now
+    and midnight is accounted for and nothing depends on a hard-coded zone.
+    """
+    tomorrow = datetime.datetime.combine(moment.date() + datetime.timedelta(days=1), datetime.time.min)
+    return datetime.datetime.fromtimestamp(time.mktime(tomorrow.timetuple())).astimezone()
+
+
+def _is_zone_name(name: str) -> bool:
+    try:
+        import zoneinfo
+
+        zoneinfo.ZoneInfo(name)
+        return True
+    except Exception:
+        return False
+
+
+def timezone_name() -> str:
+    """The server's time zone as people know it ("Europe/Berlin"); the abbreviation in force ("UTC", "CEST") if it has no name."""
+    configured = (os.environ.get("TZ") or "").strip().lstrip(":")
+    if configured:
+        # The C library uses TZ whenever it is set, and falls back to UTC when it is not a zone it knows.
+        if _is_zone_name(configured):
+            return configured
+    else:
+        target = os.path.realpath("/etc/localtime")
+        marker = "zoneinfo/"
+        if marker in target:
+            name = target.split(marker, 1)[1]
+            if _is_zone_name(name):
+                return name
+    return now().tzname() or "UTC"
+
+
+def utc_offset_text(moment: datetime.datetime) -> str:
+    offset = moment.utcoffset() or datetime.timedelta(0)
+    minutes = int(offset.total_seconds() // 60)
+    hours, rest = divmod(abs(minutes), 60)
+    return f"{'+' if minutes >= 0 else '-'}{hours:02d}:{rest:02d}"
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# What a user may do today
+# ---------------------------------------------------------------------------------------------------------------------
+
+@dataclass(frozen=True)
+class Allowance:
+    """One user's scans for one day: the limit that applies (None when unlimited), how many are used, and when it starts over."""
+
+    daily_limit: Optional[int]
+    used: int
+    resets_at: datetime.datetime
+    as_of: datetime.datetime
+
+    @property
+    def unlimited(self) -> bool:
+        return self.daily_limit is None
+
+    @property
+    def remaining(self) -> Optional[int]:
+        return None if self.daily_limit is None else max(0, self.daily_limit - self.used)
+
+    @property
+    def exhausted(self) -> bool:
+        return self.remaining == 0
+
+    @property
+    def resets_in_seconds(self) -> int:
+        return max(0, int((self.resets_at - self.as_of).total_seconds()))
+
+    def payload(self) -> dict:
+        """What the API sends: ``null`` limit and remaining mean unlimited."""
+        return {
+            "daily_limit": self.daily_limit,
+            "unlimited": self.unlimited,
+            "used": self.used,
+            "remaining": self.remaining,
+            "resets_at": self.resets_at.isoformat(),
+            "resets_in_seconds": self.resets_in_seconds,
+            "timezone": timezone_name(),
+        }
+
+
+def limit_reached_message() -> str:
+    return f"Daily scan limit reached. Scans reset at midnight ({timezone_name()})."
+
+
+class ScanLimitReached(HTTPException):
+    """HTTP 429: the user has no scans left today. Its body carries the numbers, see :func:`register_scan_limit_handler`."""
+
+    def __init__(self, allowance: Allowance):
+        self.allowance = allowance
+        super().__init__(
+            status_code=429,
+            detail=limit_reached_message(),
+            headers={"Retry-After": str(max(1, allowance.resets_in_seconds))},
+        )
+
+    def body(self) -> dict:
+        # ``detail`` stays a plain sentence like every other error of this API, so clients that only show it still read well;
+        # ``code`` tells this 429 from the rate limiter's, which is the one that is worth retrying in a moment.
+        return {"detail": self.detail, "code": LIMIT_REACHED_CODE, **self.allowance.payload()}
+
+
+async def _scan_limit_reached_handler(request, exc: ScanLimitReached) -> JSONResponse:
+    return JSONResponse(status_code=429, content=exc.body(), headers=exc.headers)
+
+
+def register_scan_limit_handler(app) -> None:
+    """Makes a :class:`ScanLimitReached` anywhere in ``app`` answer with the full 429 body."""
+    app.add_exception_handler(ScanLimitReached, _scan_limit_reached_handler)
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# The administrator's settings
+# ---------------------------------------------------------------------------------------------------------------------
+
+def default_limit(db: Session) -> tuple[bool, int]:
+    """(unlimited, number): the default for users with no limit of their own. Unlimited until someone chooses a number."""
+    unlimited_row = db.get(Setting, DEFAULT_UNLIMITED_SETTING)
+    unlimited = True if unlimited_row is None else str(unlimited_row.value).strip().lower() == "true"
+    number_row = db.get(Setting, DEFAULT_LIMIT_SETTING)
+    try:
+        number = int(number_row.value) if number_row is not None else SUGGESTED_DEFAULT_LIMIT
+    except (TypeError, ValueError):
+        number = SUGGESTED_DEFAULT_LIMIT
+    return unlimited, min(max(number, 0), MAX_DAILY_LIMIT)
+
+
+def set_default_limit(db: Session, *, unlimited: Optional[bool] = None, limit: Optional[int] = None) -> None:
+    """Stores what is given and leaves the rest. Does not commit."""
+
+    def store(key: str, value: str) -> None:
+        row = db.get(Setting, key)
+        if row is None:
+            db.add(Setting(key=key, value=value))
+        else:
+            row.value = value
+
+    if limit is not None:
+        store(DEFAULT_LIMIT_SETTING, str(int(limit)))
+    if unlimited is not None:
+        store(DEFAULT_UNLIMITED_SETTING, "true" if unlimited else "false")
+
+
+def settings_payload(db: Session, moment: Optional[datetime.datetime] = None) -> dict:
+    """The default and when a day starts over: what Settings → Scanner shows."""
+    moment = moment or now()
+    unlimited, number = default_limit(db)
+    reset = next_reset(moment)
+    return {
+        "default_unlimited": unlimited,
+        "default_limit": number,
+        "timezone": timezone_name(),
+        "utc_offset": utc_offset_text(moment),
+        "reset_time": "00:00",
+        "next_reset_at": reset.isoformat(),
+        "seconds_until_reset": max(0, int((reset - moment).total_seconds())),
+    }
+
+
+def _resolve(override: Optional[ScanLimitOverride], default_effective: Optional[int]) -> tuple[str, Optional[int], Optional[int]]:
+    """(mode, the user's own number if they have one, the limit that applies; None is unlimited)."""
+    if override is None:
+        return MODE_DEFAULT, None, default_effective
+    if override.unlimited:
+        return MODE_UNLIMITED, override.daily_limit, None
+    return MODE_CUSTOM, override.daily_limit, override.daily_limit
+
+
+def _default_effective(db: Session) -> Optional[int]:
+    unlimited, number = default_limit(db)
+    return None if unlimited else number
+
+
+def effective_limit(db: Session, user_id: int) -> Optional[int]:
+    """The number of scans a day that applies to the user; None when they are unlimited."""
+    return _resolve(db.get(ScanLimitOverride, user_id), _default_effective(db))[2]
+
+
+def set_user_limit(db: Session, user_id: int, mode: str, limit: Optional[int] = None) -> None:
+    """Gives a user the default, a limit of their own, or no limit. Does not commit."""
+    if mode not in MODES:
+        raise ValueError(f"mode must be one of {', '.join(MODES)}")
+    row = db.get(ScanLimitOverride, user_id)
+    if mode == MODE_DEFAULT:
+        if row is not None:
+            db.delete(row)
+        return
+    if mode == MODE_CUSTOM and limit is None:
+        raise ValueError("a custom limit needs a number")
+    if row is None:
+        row = ScanLimitOverride(user_id=user_id, unlimited=False)
+        db.add(row)
+    row.unlimited = mode == MODE_UNLIMITED
+    # An unlimited user keeps the number they had (or are given), so switching back to a limit starts from it.
+    if limit is not None:
+        row.daily_limit = int(limit)
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Reading usage
+# ---------------------------------------------------------------------------------------------------------------------
+
+def used_on(db: Session, user_id: int, day: datetime.date) -> int:
+    # A query of the column, not db.get(): the number is changed by UPDATE statements, which a row already loaded in this
+    # session would not show.
+    used = db.query(ScanUsage.used).filter(ScanUsage.user_id == user_id, ScanUsage.day == day).scalar()
+    return int(used) if used is not None else 0
+
+
+def current_allowance(db: Session, user_id: int, moment: Optional[datetime.datetime] = None) -> Allowance:
+    moment = moment or now()
+    return Allowance(
+        daily_limit=effective_limit(db, user_id),
+        used=used_on(db, user_id, moment.date()),
+        resets_at=next_reset(moment),
+        as_of=moment,
+    )
+
+
+def users_overview(db: Session, moment: Optional[datetime.datetime] = None) -> list[dict]:
+    """Every user with their setting, the limit that applies and what they have used today: Settings → Users."""
+    moment = moment or now()
+    default_effective = _default_effective(db)
+    overrides = {row.user_id: row for row in db.query(ScanLimitOverride).all()}
+    used = {row.user_id: int(row.used) for row in db.query(ScanUsage).filter(ScanUsage.day == moment.date()).all()}
+    rows = []
+    for user in db.query(User).order_by(User.id.asc()).all():
+        mode, own_number, limit = _resolve(overrides.get(user.id), default_effective)
+        today = used.get(user.id, 0)
+        rows.append({
+            "id": user.id,
+            "username": user.username,
+            "role": user.role,
+            "is_active": bool(user.is_active),
+            "mode": mode,
+            "custom_limit": own_number,
+            "daily_limit": limit,
+            "unlimited": limit is None,
+            "used": today,
+            "remaining": None if limit is None else max(0, limit - today),
+        })
+    return rows
+
+
+def user_overview(db: Session, user_id: int, moment: Optional[datetime.datetime] = None) -> Optional[dict]:
+    return next((row for row in users_overview(db, moment) if row["id"] == user_id), None)
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Counting
+# ---------------------------------------------------------------------------------------------------------------------
+
+def _insert_unless_present(db: Session, model, **values) -> bool:
+    """Adds a row unless one with the same key is there, as one statement; True when this call added it.
+
+    One statement is what makes it safe when two workers try at once: the database lets exactly one of them in.
+    """
+    dialect = db.get_bind().dialect.name
+    if dialect == "postgresql":
+        statement = postgresql.insert(model).values(**values).on_conflict_do_nothing()
+    elif dialect == "sqlite":
+        statement = sqlite.insert(model).values(**values).on_conflict_do_nothing()
+    else:  # pragma: no cover - PokéCollector runs on PostgreSQL, and its tests on SQLite
+        raise RuntimeError(f"Scan limits are not supported on {dialect}")
+    return db.execute(statement).rowcount == 1
+
+
+def _reserve(db: Session, user_id: int, day: datetime.date, amount: int, limit: Optional[int]) -> bool:
+    """Adds ``amount`` to the day's usage unless that would pass ``limit``. One conditional UPDATE, so concurrent callers are
+    serialised by the database and the limit can never be passed, however many requests arrive together."""
+    if amount <= 0:
+        return True
+    _insert_unless_present(db, ScanUsage, user_id=user_id, day=day, used=0)
+    statement = (
+        update(ScanUsage)
+        .where(ScanUsage.user_id == user_id, ScanUsage.day == day)
+        .values(used=ScanUsage.used + amount, updated_at=func.now())
+        .execution_options(synchronize_session=False)
+    )
+    if limit is not None:
+        statement = statement.where(ScanUsage.used + amount <= limit)
+    return db.execute(statement).rowcount == 1
+
+
+def charge_scans(
+    db: Session,
+    user_id: int,
+    *,
+    count: int = 1,
+    item_ids: Optional[Iterable[int]] = None,
+) -> Allowance:
+    """Counts scans that are about to be read, or raises :class:`ScanLimitReached` and counts nothing.
+
+    Call it right before the model is asked, after everything that can turn the request away without reading anything.
+
+    ``item_ids`` are queued photos: each is counted once, however often the queue tries it again, and a photo that was already
+    counted costs nothing. Without them ``count`` scans are counted (the direct scan of one photo). Either way all of them fit
+    or none is counted, so a group of photos that is too big for what is left is not half counted.
+
+    Commits; the counts and the markers become visible together.
+    """
+    moment = now()
+    day = moment.date()
+    limit = effective_limit(db, user_id)
+
+    if item_ids is None:
+        amount = max(0, int(count))
+    else:
+        # Claim each photo that is not counted yet. The marker is written first, so two workers on one photo count it once.
+        amount = sum(
+            1
+            for item_id in dict.fromkeys(item_ids)
+            if _insert_unless_present(db, ScanItemCharge, item_id=item_id, user_id=user_id, day=day)
+        )
+
+    if not _reserve(db, user_id, day, amount, limit):
+        db.rollback()  # takes the markers back too
+        raise ScanLimitReached(current_allowance(db, user_id, moment))
+    db.commit()
+    return current_allowance(db, user_id, moment)
+
+
+def ensure_scans_available(db: Session, user_id: int) -> Allowance:
+    """Raises :class:`ScanLimitReached` when the user has no scan left today; otherwise says what they have. Counts nothing."""
+    allowance = current_allowance(db, user_id)
+    if allowance.exhausted:
+        raise ScanLimitReached(allowance)
+    return allowance
+
+
+def forget_item_charges(db: Session, item_ids: Iterable[int]) -> None:
+    """Makes photos that were counted countable again, because their owner asked for them to be read again. Does not commit."""
+    ids = list(dict.fromkeys(item_ids))
+    if ids:
+        db.query(ScanItemCharge).filter(ScanItemCharge.item_id.in_(ids)).delete(synchronize_session=False)
