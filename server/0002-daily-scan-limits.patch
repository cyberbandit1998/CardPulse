diff --git a/backend/tests/scan_limits_world.py b/backend/tests/scan_limits_world.py
new file mode 100644
index 0000000..5a0df78
--- /dev/null
+++ b/backend/tests/scan_limits_world.py
@@ -0,0 +1,102 @@
+"""A small world for the scan-limit tests: three people, a database, and a clock that can be moved.
+
+    ash    a trainer, the user most tests count scans for
+    misty  another trainer
+    oak    an admin
+
+The time zone and the clock are the part that is easy to get wrong, so they are controlled here. Everything in
+services/scan_limits.py reads the time through ``scan_limits.now()``, and works out the day's end with the C library, so a test
+sets the TZ environment variable (and ``time.tzset()``) as well as the instant.
+"""
+
+import datetime
+import os
+import time
+from unittest.mock import patch
+
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+from sqlalchemy.pool import StaticPool
+
+from database import Base
+from models import ScanJob, ScanJobItem, User
+from services import scan_limits
+
+
+def local_time(year, month, day, hour=12, minute=0, second=0) -> datetime.datetime:
+    """A moment as the server's local clock shows it, with the offset that is in force then (TZ must already be set)."""
+    naive = datetime.datetime(year, month, day, hour, minute, second)
+    return datetime.datetime.fromtimestamp(time.mktime(naive.timetuple())).astimezone()
+
+
+class ScanLimitsWorld:
+    def __init__(self):
+        # SQLite in memory by default. Point SCAN_LIMITS_TEST_DATABASE_URL at an empty PostgreSQL database to run the same
+        # tests on the database the server really uses; its tables are dropped when each test ends.
+        database_url = os.environ.get("SCAN_LIMITS_TEST_DATABASE_URL", "sqlite:///:memory:")
+        self.is_postgres = database_url.startswith("postgresql")
+        options = {"connect_args": {"check_same_thread": False}, "poolclass": StaticPool} if database_url.startswith("sqlite") else {}
+        self.engine = create_engine(database_url, **options)
+        Base.metadata.create_all(self.engine)
+        self.session_factory = sessionmaker(bind=self.engine)
+        self.db = self.session_factory()
+        self.ash = self._user("ash")
+        self.misty = self._user("misty")
+        self.oak = self._user("oak", role="admin")
+
+    def _user(self, name, role="trainer"):
+        user = User(username=name, hashed_password="x", role=role, is_active=True)
+        self.db.add(user)
+        self.db.commit()
+        return user
+
+    def photos(self, user, count):
+        """Queued photos of ``user`` (a job with ``count`` items), as their ids. The counts of queued photos point at real
+        rows, which PostgreSQL insists on."""
+        now = datetime.datetime.utcnow()
+        job = ScanJob(user_id=user.id, status="pending", created_at=now, updated_at=now, expires_at=now + datetime.timedelta(days=14))
+        self.db.add(job)
+        self.db.flush()
+        items = [
+            ScanJobItem(
+                job_id=job.id, user_id=user.id, position=position, image_path=f"{job.id}/{position}.jpg", content_type="image/jpeg",
+                byte_size=5, status="pending", resolved=False, attempts=0, transient_failures=0, next_attempt_at=now,
+                created_at=now, updated_at=now,
+            )
+            for position in range(count)
+        ]
+        self.db.add_all(items)
+        self.db.commit()
+        return [item.id for item in items]
+
+    def session(self):
+        """Another session on the same database, as the next request (or the backend after a restart) would have."""
+        return self.session_factory()
+
+    def close(self):
+        self.db.close()
+        Base.metadata.drop_all(self.engine)
+        self.engine.dispose()
+
+
+class Clock:
+    """The server's clock and time zone for one test. ``clock.at(...)`` moves it; undone when the test ends."""
+
+    def __init__(self, test_case, time_zone="Europe/Berlin"):
+        env = patch.dict(os.environ, {"TZ": time_zone})
+        env.start()
+        time.tzset()
+        self.now = None
+        patcher = patch.object(scan_limits, "now", lambda: self.now)
+        patcher.start()
+
+        def restore():
+            patcher.stop()
+            env.stop()
+            time.tzset()
+
+        test_case.addCleanup(restore)
+
+    def at(self, year, month, day, hour=12, minute=0, second=0):
+        self.now = local_time(year, month, day, hour, minute, second)
+        return self.now
