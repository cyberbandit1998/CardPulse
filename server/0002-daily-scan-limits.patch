+    @unittest.skipUnless(os.environ.get("SCAN_LIMITS_TEST_DATABASE_URL", "").startswith("postgresql"), "needs PostgreSQL")
+    def test_many_threads_asking_at_once_never_pass_the_limit(self):
+        self.set_default(limit=7)
+        successes, refused, errors = [], [], []
+        gate = threading.Barrier(12)
+
+        def worker():
+            session = self.world.session()
+            try:
+                gate.wait()
+                try:
+                    limits.charge_scans(session, self.ash.id)
+                    successes.append(1)
+                except limits.ScanLimitReached:
+                    refused.append(1)
+            except Exception as error:  # pragma: no cover - reported below
+                errors.append(error)
+            finally:
+                session.close()
+
+        threads = [threading.Thread(target=worker) for _ in range(12)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(errors, [])
+        self.assertEqual((len(successes), len(refused)), (7, 5))
+        self.assertEqual(self.allowance(self.ash).used, 7)
