+import { renderToStaticMarkup } from 'react-dom/server'
+import { describe, expect, it } from 'vitest'
+
+import { ScanLimitForm } from './ScanLimitSettingsCard'
+import UserScanLimitControl from './UserScanLimitControl'
+
+const translations = {
+  'settings.scanLimits.title': 'Daily scan limit',
+  'settings.scanLimits.desc': 'About the limit',
+  'settings.scanLimits.unlimitedByDefault': 'Unlimited by default',
+  'settings.scanLimits.unlimitedByDefaultDesc': 'About unlimited',
+  'settings.scanLimits.defaultLimit': 'Default daily scan limit',
+  'settings.scanLimits.defaultLimitDesc': 'About the default',
+  'settings.scanLimits.perUserPerDay': 'scans per user per day',
+  'settings.scanLimits.invalidLimit': 'Enter a whole number',
+  'settings.scanLimits.resetsTitle': 'Reset',
+  'settings.scanLimits.resetsDesc': 'About the reset',
+  'settings.scanLimits.timezone': 'Server time zone',
+  'settings.scanLimits.nextReset': 'Next reset',
+  'settings.scanLimits.timezoneHint': 'About TZ',
+  'settings.scanLimits.dailyScans': 'Daily scans',
+  'settings.scanLimits.today': 'today',
+  'settings.scanLimits.unlimited': 'Unlimited',
+  'settings.scanLimits.useDefault': 'Use default',
+  'settings.scanLimits.custom': 'Custom',
+  'settings.scanLimits.customLimit': 'Custom daily scan limit',
+  'common.save': 'Save',
+}
+const t = key => translations[key] || key
+
+const settings = {
+  default_unlimited: false,
+  default_limit: 100,
+  timezone: 'Europe/Berlin',
+  utc_offset: '+02:00',
+  reset_time: '00:00',
+  next_reset_at: '2026-10-10T00:00:00+02:00',
+  seconds_until_reset: 43200,
+}
+const noon = new Date('2026-10-09T12:00:00+02:00')
+
+const render = (element) => renderToStaticMarkup(element)
+
+describe('the default limit (Settings → Scanner)', () => {
+  it('shows the number, the switch, the time zone and when the day starts over', () => {
+    const html = render(<ScanLimitForm t={t} settings={settings} onSave={() => {}} now={noon} />)
+
+    expect(html).toContain('Daily scan limit')
+    expect(html).toMatch(/<input[^>]*id="scan-limit-default"[^>]*value="100"/)
+    expect(html).toContain('aria-pressed="false"') // not unlimited
+    expect(html).toContain('Europe/Berlin (UTC+02:00)')
+    expect(html).toContain('in about 12 hours')
+    expect(html).toContain('About TZ')
+  })
+
+  it('has nothing to save until something is changed', () => {
+    const html = render(<ScanLimitForm t={t} settings={settings} onSave={() => {}} now={noon} />)
+    expect(html).toMatch(/<button[^>]*disabled=""[^>]*>Save<\/button>/)
+  })
+
+  it('shows an unlimited default with the number kept but switched off', () => {
+    const html = render(<ScanLimitForm t={t} settings={{ ...settings, default_unlimited: true }} onSave={() => {}} now={noon} />)
+
+    expect(html).toContain('aria-pressed="true"')
+    expect(html).toMatch(/<input[^>]*id="scan-limit-default"[^>]*disabled=""/)
+    expect(html).toMatch(/<input[^>]*id="scan-limit-default"[^>]*value="100"/)
+  })
+
+  it('shows a time zone without an offset when the server sent none', () => {
+    const html = render(
+      <ScanLimitForm t={t} settings={{ ...settings, utc_offset: undefined, timezone: 'UTC' }} onSave={() => {}} now={noon} />,
+    )
+    expect(html).toContain('>UTC<')
+  })
+})
+
+describe("a user's limit (Settings → Users)", () => {
+  const user = { id: 7, username: 'ash', mode: 'default', custom_limit: null, daily_limit: 100, unlimited: false, used: 34, remaining: 66 }
+  const control = (row, extra = {}) => render(<UserScanLimitControl t={t} row={row} onChange={() => {}} {...extra} />)
+
+  it('shows what the user has used today next to the limit that applies', () => {
+    const html = control(user)
+    expect(html).toContain('34 / 100 today')
+    expect(html).toContain('Daily scans')
+    expect(html).toContain('data-testid="scan-limit-7"')
+  })
+
+  it('offers the default, a limit of their own, and unlimited, with the current one chosen', () => {
+    const html = control(user)
+    expect(html).toMatch(/role="radio"[^>]*aria-checked="true"[^>]*>Use default</)
+    expect(html).toMatch(/role="radio"[^>]*aria-checked="false"[^>]*>Custom</)
+    expect(html).toMatch(/role="radio"[^>]*aria-checked="false"[^>]*>Unlimited</)
+    expect(html).not.toContain('type="number"') // the number box is only there for a limit of their own
+  })
+
+  it('shows the number of a custom limit in a box of its own, with nothing to save yet', () => {
+    const html = control({ ...user, mode: 'custom', custom_limit: 50, daily_limit: 50, used: 5 })
+
+    expect(html).toContain('5 / 50 today')
+    expect(html).toMatch(/role="radio"[^>]*aria-checked="true"[^>]*>Custom</)
+    expect(html).toMatch(/<input[^>]*type="number"[^>]*value="50"/)
+    expect(html).toMatch(/<button[^>]*disabled=""[^>]*>Save<\/button>/)
+  })
+
+  it('shows an unlimited user with the word Unlimited instead of a number to be used up', () => {
+    const html = control({ ...user, mode: 'unlimited', custom_limit: 50, daily_limit: null, unlimited: true, used: 12, remaining: null })
+
+    expect(html).toContain('12 today · Unlimited')
+    expect(html).toMatch(/role="radio"[^>]*aria-checked="true"[^>]*>Unlimited</)
+    expect(html).not.toContain('type="number"')
+  })
+
+  it('locks the choices while a change is being saved', () => {
+    const html = control(user, { busy: true })
+    expect(html.match(/disabled=""/g)).toHaveLength(3)
+  })
+})
diff --git a/frontend/src/components/UserScanLimitControl.jsx b/frontend/src/components/UserScanLimitControl.jsx
new file mode 100644
index 0000000..47f720c
--- /dev/null
+++ b/frontend/src/components/UserScanLimitControl.jsx
@@ -0,0 +1,100 @@
+import { useEffect, useState } from 'react'
+
+import {
+  MAX_DAILY_SCAN_LIMIT,
+  SCAN_LIMIT_MODES,
+  formatScanUsage,
+  parseScanLimit,
+  startingLimit,
+} from '../utils/scanLimits'
+
+// One user's daily scan limit, under their row in Settings → Users (admins only; docs/SCAN_LIMITS.md): how much they have used
+// today, and whether they use the default limit, one of their own, or none. Choosing "Use default" or "Unlimited" saves at
+// once; a number of their own is saved with its button, so nothing half typed is ever applied.
+//
+// `row` is what the server sends for the user: mode, custom_limit, daily_limit (the limit that applies; null is unlimited),
+// used, remaining. `onChange` gets the body for the server: {mode} or {mode: 'custom', limit}.
+export default function UserScanLimitControl({ t, row, busy = false, onChange }) {
+  const [text, setText] = useState(startingLimit(row))
+
+  // What the server confirmed is what the box shows.
+  useEffect(() => {
+    setText(startingLimit(row))
+  }, [row.mode, row.custom_limit, row.daily_limit])
+
+  const typed = parseScanLimit(text)
+  const custom = row.mode === 'custom'
+  const invalid = custom && typed === null
+  const changed = custom && typed !== null && typed !== row.custom_limit
+
+  const words = { today: t('settings.scanLimits.today'), unlimited: t('settings.scanLimits.unlimited') }
+  const labels = {
+    default: t('settings.scanLimits.useDefault'),
+    custom: t('settings.scanLimits.custom'),
+    unlimited: t('settings.scanLimits.unlimited'),
+  }
+
+  const choose = (mode) => {
+    if (busy || mode === row.mode) return
+    if (mode === 'custom') {
+      if (typed === null) return
+      onChange({ mode: 'custom', limit: typed })
+      return
+    }
+    onChange({ mode })
+  }
+
+  return (
+    <div className="px-4 pb-3.5 -mt-1 flex flex-wrap items-center gap-x-3 gap-y-2" data-testid={`scan-limit-${row.id}`}>
+      <span className="text-xs text-text-muted">{t('settings.scanLimits.dailyScans')}</span>
+      <span className="text-xs font-semibold text-text-primary tabular-nums">{formatScanUsage(row, words)}</span>
+
+      <div role="radiogroup" aria-label={t('settings.scanLimits.dailyScans')} className="flex flex-wrap gap-1.5">
+        {SCAN_LIMIT_MODES.map(mode => (
+          <button
+            key={mode}
+            type="button"
+            role="radio"
+            aria-checked={row.mode === mode}
+            disabled={busy}
+            onClick={() => choose(mode)}
+            className={`px-2 py-1 rounded-lg text-[11px] font-semibold border transition-colors disabled:opacity-60 ${
+              row.mode === mode
+                ? 'bg-brand-red text-white border-brand-red'
+                : 'bg-bg-card text-text-muted border-border hover:text-text-primary'
+            }`}
+          >
+            {labels[mode]}
+          </button>
+        ))}
+      </div>
+
+      {custom && (
+        <div className="flex items-center gap-1.5">
+          <input
+            type="number"
+            inputMode="numeric"
+            min="0"
+            max={MAX_DAILY_SCAN_LIMIT}
+            step="1"
+            value={text}
+            onChange={event => setText(event.target.value)}
+            disabled={busy}
+            aria-label={t('settings.scanLimits.customLimit')}
+            aria-invalid={invalid}
+            className="input w-24 text-xs"
+          />
+          <button
+            type="button"
+            onClick={() => onChange({ mode: 'custom', limit: typed })}
+            disabled={busy || invalid || !changed}
+            className="btn-primary text-[11px] px-2.5 py-1"
+          >
+            {t('common.save')}
+          </button>
+        </div>
+      )}
+      {invalid && <span role="alert" className="text-[11px] text-brand-red">{t('settings.scanLimits.invalidLimit')}</span>}
+    </div>
+  )
+}
