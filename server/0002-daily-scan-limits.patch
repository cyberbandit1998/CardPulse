+    await expect(page.getByText('Daily scan limit saved').first()).toBeVisible()
+    expect(api.writes.settings).toEqual([{ default_unlimited: false, default_limit: 50 }])
+    await expect(card.getByRole('button', { name: 'Save' })).toBeDisabled()
