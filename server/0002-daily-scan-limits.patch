diff --git a/frontend/src/components/ScanLimitSettingsCard.jsx b/frontend/src/components/ScanLimitSettingsCard.jsx
new file mode 100644
index 0000000..034426b
--- /dev/null
+++ b/frontend/src/components/ScanLimitSettingsCard.jsx
@@ -0,0 +1,153 @@
+import { useEffect, useState } from 'react'
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
+import { formatDistance } from 'date-fns'
+import toast from 'react-hot-toast'
+
+import { getScanLimitSettings, updateScanLimitSettings } from '../api/client'
+import {
+  MAX_DAILY_SCAN_LIMIT,
+  defaultLimitChange,
+  parseScanLimit,
+  zoneLabel,
+} from '../utils/scanLimits'
+
+// The daily scan limit for everyone who has none of their own (admins only; docs/SCAN_LIMITS.md). It sits in Settings →
+// General, in the AI / card scanner section, under the scanner's own settings. A user's own limit is set in Settings → Users.
+
+const CARD_STYLE = { background: 'rgba(255,255,255,0.04)', border: '1px solid rgba(255,255,255,0.07)' }
+const INNER_STYLE = { background: 'rgba(255,255,255,0.025)', border: '1px solid rgba(255,255,255,0.05)' }
+
+// The same switch as the rest of Settings (that one is private to the page).
+function Switch({ value, onChange, label, disabled = false }) {
+  return (
+    <button
+      type="button"
+      onClick={() => onChange(!value)}
+      disabled={disabled}
+      className={`relative w-11 h-6 flex-shrink-0 rounded-full transition-colors duration-200 ${
+        value ? 'bg-brand-red' : 'bg-bg-elevated border border-border'
+      } ${disabled ? 'cursor-not-allowed opacity-50' : ''}`}
+      aria-pressed={value}
+      aria-label={label}
+    >
+      <span
+        className={`absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow transition-transform duration-200 ${
+          value ? 'translate-x-5' : 'translate-x-0'
+        }`}
+      />
+    </button>
+  )
+}
+
+// The form on its own: what the server sent in, what the admin wants out. `now` is only there so tests can fix the clock.
+export function ScanLimitForm({ t, settings, saving = false, onSave, now = new Date() }) {
+  const [unlimited, setUnlimited] = useState(settings.default_unlimited)
+  const [text, setText] = useState(String(settings.default_limit))
+
+  // A save, or a change made elsewhere, brings the form back in line with the server.
+  useEffect(() => {
+    setUnlimited(settings.default_unlimited)
+    setText(String(settings.default_limit))
+  }, [settings.default_unlimited, settings.default_limit])
+
+  const limit = parseScanLimit(text)
+  const invalid = !unlimited && limit === null
+  const change = defaultLimitChange(settings, { unlimited, limit: limit ?? settings.default_limit })
+  const dirty = Object.keys(change).length > 0
+  const reset = settings.next_reset_at ? new Date(settings.next_reset_at) : null
+
+  return (
+    <div className="rounded-2xl overflow-hidden" style={CARD_STYLE} data-testid="scan-limit-default">
+      <div className="px-4 py-4 space-y-4">
+        <div>
+          <p className="text-sm font-semibold text-text-primary">{t('settings.scanLimits.title')}</p>
+          <p className="text-xs text-text-muted mt-1 max-w-2xl">{t('settings.scanLimits.desc')}</p>
+        </div>
+
+        <div className="flex items-center justify-between gap-3">
+          <div className="min-w-0">
+            <p className="text-xs font-semibold text-text-primary">{t('settings.scanLimits.unlimitedByDefault')}</p>
+            <p className="text-[11px] text-text-muted mt-0.5">{t('settings.scanLimits.unlimitedByDefaultDesc')}</p>
+          </div>
+          <Switch value={unlimited} onChange={setUnlimited} label={t('settings.scanLimits.unlimitedByDefault')} disabled={saving} />
+        </div>
+
+        <div>
+          <label htmlFor="scan-limit-default" className="text-xs font-semibold text-text-primary">
+            {t('settings.scanLimits.defaultLimit')}
+          </label>
+          <div className="mt-1.5 flex flex-wrap items-center gap-2">
+            <input
+              id="scan-limit-default"
+              type="number"
+              inputMode="numeric"
+              min="0"
+              max={MAX_DAILY_SCAN_LIMIT}
+              step="1"
+              value={text}
+              onChange={event => setText(event.target.value)}
+              disabled={unlimited || saving}
+              aria-invalid={invalid}
+              className="input w-32 text-xs"
+            />
+            <span className="text-xs text-text-muted">{t('settings.scanLimits.perUserPerDay')}</span>
+            <button
+              type="button"
+              onClick={() => onSave(change)}
+              disabled={!dirty || invalid || saving}
+              className="btn-primary text-xs"
+            >
+              {t('common.save')}
+            </button>
+          </div>
+          {invalid && <p role="alert" className="mt-1 text-[11px] text-brand-red">{t('settings.scanLimits.invalidLimit')}</p>}
+          <p className="mt-1 text-[11px] text-text-muted">{t('settings.scanLimits.defaultLimitDesc')}</p>
+        </div>
+
+        <div className="rounded-xl px-3 py-2.5" style={INNER_STYLE}>
+          <p className="text-xs font-semibold text-text-primary">{t('settings.scanLimits.resetsTitle')}</p>
+          <p className="text-[11px] text-text-muted mt-1">{t('settings.scanLimits.resetsDesc')}</p>
+          <p className="text-[11px] text-text-muted mt-1">
+            {t('settings.scanLimits.timezone')}: <span className="font-semibold text-text-primary">{zoneLabel(settings)}</span>
+          </p>
+          {reset && (
+            <p className="text-[11px] text-text-muted mt-1">
+              {t('settings.scanLimits.nextReset')}:{' '}
+              <span className="font-semibold text-text-primary">{formatDistance(reset, now, { addSuffix: true })}</span>
+              {' · '}
+              {reset.toLocaleString()}
+            </p>
+          )}
+          <p className="text-[11px] text-text-muted mt-1">{t('settings.scanLimits.timezoneHint')}</p>
+        </div>
+      </div>
+    </div>
+  )
+}
+
+export default function ScanLimitSettingsCard({ t }) {
+  const queryClient = useQueryClient()
+  const { data, isLoading, isError } = useQuery({ queryKey: ['scan-limit-settings'], queryFn: getScanLimitSettings })
+  const save = useMutation({
+    mutationFn: updateScanLimitSettings,
+    onSuccess: (saved) => {
+      queryClient.setQueryData(['scan-limit-settings'], saved)
+      // The users list shows the limit that applies to each user, which the default is part of.
+      queryClient.invalidateQueries({ queryKey: ['scan-limits-users'] })
+      toast.success(t('settings.scanLimits.saved'))
+    },
+    onError: (error) => toast.error(error.response?.data?.detail || t('common.error')),
+  })
+
+  if (isLoading) return null
+  if (isError || typeof data?.default_limit !== 'number') {
+    // An older server without the update has no such route: say so rather than showing a form that cannot work.
+    return (
+      <div className="rounded-2xl px-4 py-3" style={CARD_STYLE}>
+        <p className="text-sm font-semibold text-text-primary">{t('settings.scanLimits.title')}</p>
+        <p className="text-xs text-text-muted mt-1">{t('settings.scanLimits.unavailable')}</p>
+      </div>
+    )
+  }
+  return <ScanLimitForm t={t} settings={data} saving={save.isPending} onSave={(change) => save.mutate(change)} />
+}
