+
+    def test_a_group_that_no_longer_fits_is_read_photo_by_photo_instead(self):
+        limits.set_default_limit(self.db, unlimited=False, limit=3)
+        self.db.commit()
+        limits.charge_scans(self.db, self.ash.id, count=2)
+        photos = self.world.photos(self.ash, 3)
+
+        results, composite = self.run_group([b"a", b"b", b"c"], photos)
+
+        self.assertEqual(results, [None, None, None])  # the queue puts each photo back to be read on its own
+        composite.assert_not_awaited()
+        self.assertEqual(self.used(self.ash), 2)  # nothing was counted for the group
+        for item_id in photos:
+            self.assertIsNone(self.db.get(ScanItemCharge, item_id))
+
+    def test_a_group_with_no_scan_left_asks_no_model_either(self):
+        limits.set_default_limit(self.db, unlimited=False, limit=0)
+        self.db.commit()
+
+        results, composite = self.run_group([b"a", b"b"], self.world.photos(self.ash, 2))
+
+        self.assertEqual(results, [None, None])
+        composite.assert_not_awaited()
+        self.assertEqual(self.used(self.ash), 0)
+
+    def test_photos_of_a_group_that_were_counted_before_are_not_counted_again(self):
+        limits.set_default_limit(self.db, unlimited=False, limit=10)
+        self.db.commit()
+        first, second = self.world.photos(self.ash, 2)
+        limits.charge_scans(self.db, self.ash.id, item_ids=[first])
+
+        self.run_group([b"a", b"b"], [first, second])
+
+        self.assertEqual(self.used(self.ash), 2)  # photo 1 once, photo 2 once
+
+    def test_a_group_with_an_unlimited_user_is_always_read(self):
+        limits.set_default_limit(self.db, unlimited=False, limit=0)
+        limits.set_user_limit(self.db, self.ash.id, "unlimited")
+        self.db.commit()
+
+        results, composite = self.run_group([b"a", b"b"], self.world.photos(self.ash, 2))
+
+        composite.assert_awaited_once()
+        self.assertTrue(all(result is not None for result in results))
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# The place the count is taken: right before the model is asked
+# ---------------------------------------------------------------------------------------------------------------------
+
+@unittest.skipUnless(DEPS, "FastAPI/SQLAlchemy are not installed in this lightweight test environment")
+class CountedJustBeforeTheModelTests(unittest.IsolatedAsyncioTestCase):
+    @staticmethod
+    def provider(*, is_gemini=True, key="a-key", requires_key=True):
+        provider = provider_double(key=key, requires_key=requires_key, is_gemini=is_gemini)
+        return provider
+
+    @contextlib.contextmanager
+    def patched(self, provider, *, capability="full", matcher=None):
+        with contextlib.ExitStack() as stack:
+            stack.enter_context(patch("api.recognize.get_provider", return_value=provider))
+            stack.enter_context(patch("api.recognize.require_scanner_capability_mode", return_value=capability))
+            stack.enter_context(patch("api.recognize.resolve_scanner_request_timeout", return_value=30))
+            stack.enter_context(patch(
+                "api.recognize.match_card_info",
+                new=matcher or AsyncMock(return_value={"recognized": {}, "matches": [], "_identity_confident": True}),
+            ))
+            yield
+
+    async def test_the_hook_runs_after_the_checks_and_before_the_model(self):
+        provider = self.provider()
+        order = []
+        provider.credential.side_effect = lambda *_: order.append("credential") or "a-key"
+        provider.generate_text = AsyncMock(side_effect=lambda *_a, **_k: order.append("model") or ('{"name":"Pikachu"}', None))
+
+        with self.patched(provider):
+            await recognize_sanitized_card(object(), 7, b"image", "image/jpeg", before_provider_call=lambda: order.append("hook"))
+
+        self.assertEqual(order, ["credential", "hook", "model"])
+
+    async def test_a_refusal_from_the_hook_stops_the_model_from_being_asked(self):
+        provider = self.provider()
+
+        def refuse():
+            raise HTTPException(status_code=429, detail="no")
+
+        with self.patched(provider), self.assertRaises(HTTPException) as caught:
+            await recognize_sanitized_card(object(), 7, b"image", "image/jpeg", before_provider_call=refuse)
+
+        self.assertEqual(caught.exception.status_code, 429)
+        provider.generate_text.assert_not_awaited()
+
+    async def test_a_missing_key_never_reaches_the_hook(self):
+        provider = self.provider(key="", requires_key=True)
+        hook = Mock()
+
+        with self.patched(provider), self.assertRaises(HTTPException) as caught:
+            await recognize_sanitized_card(object(), 7, b"image", "image/jpeg", before_provider_call=hook)
+
+        self.assertEqual(caught.exception.status_code, 400)
+        hook.assert_not_called()
+
+    async def test_a_scanner_that_needs_testing_again_never_reaches_the_hook(self):
+        provider = self.provider()
+        hook = Mock()
+        with patch("api.recognize.get_provider", return_value=provider), patch(
+            "api.recognize.resolve_scanner_request_timeout", return_value=30
+        ), patch(
+            "api.recognize.require_scanner_capability_mode",
+            side_effect=HTTPException(status_code=409, detail="Test and save again."),
+        ), self.assertRaises(HTTPException):
+            await recognize_sanitized_card(object(), 7, b"image", "image/jpeg", before_provider_call=hook)
+
+        hook.assert_not_called()
+
+    async def test_the_second_opinion_from_gemini_is_part_of_the_same_scan(self):
+        # An OpenAI-compatible provider (Groq, say) that is not sure, with the Gemini fallback on: two requests are made to
+        # two models for one photo. The scan is counted once, at the first of them.
+        primary = self.provider(is_gemini=False, key="", requires_key=False)
+        gemini = self.provider(is_gemini=True)
+        results = iter([
+            {"recognized": {}, "matches": [{"id": "groq"}], "_identity_confident": False, "_identity_decision": None},
+            {"recognized": {}, "matches": [{"id": "gemini"}], "_identity_confident": True, "_identity_decision": None},
+        ])
+        matcher = AsyncMock(side_effect=lambda *a, **k: next(results))
+        hook = Mock()
+
+        with self.patched(primary, matcher=matcher), patch(
+            "api.recognize.gemini_fallback_enabled", return_value=True
+        ), patch("api.recognize.get_gemini_key", return_value="gemini-key"), patch(
+            "api.recognize.resolve_model", return_value="gemini-model"
+        ), patch("api.recognize.ScanProvider", return_value=gemini):
+            result = await recognize_sanitized_card(object(), 7, b"image", "image/jpeg", before_provider_call=hook)
+
+        self.assertEqual(result["matches"][0]["id"], "gemini")
+        primary.generate_text.assert_awaited_once()
+        gemini.generate_text.assert_awaited_once()
+        hook.assert_called_once_with()
+
+    async def test_scanning_with_groq_through_the_openai_compatible_provider_is_counted_like_any_other(self):
+        # Nothing here is specific to a provider: whichever model reads the photo, the count is taken the same way.
+        provider = self.provider(is_gemini=False, key="groq-key", requires_key=True)
+        hook = Mock()
+
+        with self.patched(provider):
+            await recognize_sanitized_card(object(), 7, b"image", "image/jpeg", before_provider_call=hook)
+
+        provider.generate_text.assert_awaited_once()
+        hook.assert_called_once_with()
+
+    async def test_without_a_hook_nothing_changes(self):
+        provider = self.provider()
+
+        with self.patched(provider):
+            result = await recognize_sanitized_card(object(), 7, b"image", "image/jpeg")
+
+        provider.generate_text.assert_awaited_once()
+        self.assertIsNotNone(result)
+
+
+if __name__ == "__main__":
+    unittest.main()
