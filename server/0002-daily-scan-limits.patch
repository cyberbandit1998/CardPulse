+    def test_two_requests_for_the_last_scan_are_not_both_allowed(self):
+        """Each request has a session of its own, as in the server. The conditional UPDATE is what decides, not the order in
+        which they looked."""
+        self.set_default(limit=1)
+        first, second = self.world.session(), self.world.session()
+        try:
+            # Both look first (both see one scan left), then both ask to count it.
+            self.assertEqual(limits.current_allowance(first, self.ash.id).remaining, 1)
+            self.assertEqual(limits.current_allowance(second, self.ash.id).remaining, 1)
+            limits.charge_scans(first, self.ash.id)
+            with self.assertRaises(limits.ScanLimitReached):
+                limits.charge_scans(second, self.ash.id)
+        finally:
+            first.close()
+            second.close()
+        self.assertEqual(self.allowance(self.ash).used, 1)
