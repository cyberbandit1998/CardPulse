+import { expect, test } from '@playwright/test'
+
+// Daily scan limits in the admin screens (docs/SCAN_LIMITS.md): the default under Settings → AI / Card Scanner, and each user's
+// own limit and usage under Settings → Users. The server is replaced by a small stand-in that keeps the same rules.
+
+const ADMIN = { id: 1, username: 'oak', role: 'admin', is_active: true, must_change_password: false }
+const TRAINER = { id: 2, username: 'ash', role: 'trainer', is_active: true, must_change_password: false }
+
+const scannerConfiguration = {
+  provider: 'gemini',
+  model: 'gemini-flash-latest',
+  request_timeout_seconds: 30,
+  request_timeout_options: [30, 60, 120, 180],
