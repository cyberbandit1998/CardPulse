+    # --- helpers ------------------------------------------------------------------------------------------------------
+
+    def headers(self, user):
+        return {"Authorization": "Bearer " + create_access_token({"sub": str(user.id), "role": user.role})}
+
+    def get(self, path, user=None):
+        return self.client.get(path, headers=self.headers(user) if user else {})
+
+    def put(self, path, user, body):
+        return self.client.put(path, headers=self.headers(user), json=body)
+
+    def set_default(self, limit=None, unlimited=False):
+        limits.set_default_limit(self.world.db, unlimited=unlimited, limit=limit)
+        self.world.db.commit()
+
+    def set_user(self, user, mode, limit=None):
+        limits.set_user_limit(self.world.db, user.id, mode, limit)
+        self.world.db.commit()
+
+    def used(self, user):
+        self.world.db.expire_all()
+        return limits.used_on(self.world.db, user.id, self.clock.now.date())
+
+    @contextlib.contextmanager
+    def scanner(self, provider=None, *, capability="full"):
+        """The direct scan with the model replaced: `provider.generate_text` is what 'asking the model' means."""
+        provider = provider or provider_double()
+        with contextlib.ExitStack() as stack:
+            stack.enter_context(patch("api.recognize.get_provider", return_value=provider))
+            stack.enter_context(patch("api.recognize.require_scanner_capability_mode", return_value=capability))
+            stack.enter_context(patch("api.recognize.resolve_scanner_request_timeout", return_value=30))
+            stack.enter_context(patch(
+                "api.recognize.match_card_info",
+                new=AsyncMock(return_value={"recognized": {"name": "Pikachu"}, "matches": [], "_identity_confident": True}),
+            ))
+            yield provider
+
+    def scan(self, user, content=None, content_type="image/jpeg"):
+        return self.client.post(
+            "/api/cards/recognize",
+            headers=self.headers(user),
+            files={"file": ("card.jpg", jpeg_bytes() if content is None else content, content_type)},
+        )
+
+    def enqueue(self, user, photos=1):
+        with patch("api.recognize.get_gemini_key", return_value="secret-key"), patch(
+            "api.scan_jobs.drain_scan_queue", new=AsyncMock(return_value=0)
+        ):
+            return self.client.post(
+                "/api/cards/recognize/jobs",
+                headers=self.headers(user),
+                files=[("files", (f"card-{n}.jpg", jpeg_bytes(), "image/jpeg")) for n in range(photos)],
+            )
+
+    def assert_limit_reached(self, response, *, limit, used):
+        self.assertEqual(response.status_code, 429, response.text)
+        body = response.json()
+        self.assertEqual(body["code"], "scan_limit_reached")
+        self.assertTrue(body["detail"].startswith("Daily scan limit reached"), body["detail"])
+        self.assertEqual((body["daily_limit"], body["used"], body["remaining"], body["unlimited"]), (limit, used, max(0, limit - used), False))
+        self.assertEqual(body["resets_at"], "2026-10-10T00:00:00+02:00")
+        self.assertEqual(body["resets_in_seconds"], 12 * 3600)
+        self.assertEqual(body["timezone"], "Europe/Berlin")
+        self.assertEqual(response.headers["retry-after"], str(12 * 3600))
+        return body
