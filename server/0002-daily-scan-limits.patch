+class MichiganServerTests(HttpBase):
+    """The zone this server is recommended to run in (TZ=America/Detroit): what the 429 and the admin's card say about the reset."""
+
+    def setUp(self):
+        super().setUp()
+        self.clock = Clock(self, "America/Detroit")
+        self.clock.at(2026, 10, 9, 18, 48)  # 18:48 in daylight time: five hours and twelve minutes to midnight
+        self.until_midnight = 5 * 3600 + 12 * 60
+
+    def test_the_429_names_michigans_midnight(self):
+        self.set_default(limit=1)
+        with self.scanner():
+            self.assertEqual(self.scan(self.ash).status_code, 200)
+            refused = self.scan(self.ash)
+
+        self.assertEqual(refused.status_code, 429, refused.text)
+        body = refused.json()
+        self.assertEqual(body["code"], "scan_limit_reached")
+        self.assertEqual(body["detail"], "Daily scan limit reached. Scans reset at midnight (America/Detroit).")
+        self.assertEqual((body["daily_limit"], body["used"], body["remaining"], body["unlimited"]), (1, 1, 0, False))
+        self.assertEqual(body["resets_at"], "2026-10-10T00:00:00-04:00")
+        self.assertEqual(body["resets_in_seconds"], self.until_midnight)
+        self.assertEqual(body["timezone"], "America/Detroit")
+        self.assertEqual(refused.headers["retry-after"], str(self.until_midnight))
+
+    def test_queueing_photos_at_the_limit_is_the_same_429(self):
+        self.set_default(limit=0)
+
+        refused = self.enqueue(self.ash)
+
+        self.assertEqual(refused.status_code, 429, refused.text)
+        self.assertEqual(refused.json()["resets_at"], "2026-10-10T00:00:00-04:00")
+        self.assertEqual(refused.json()["timezone"], "America/Detroit")
+
+    def test_what_a_user_is_told_and_what_the_admin_sees_agree(self):
+        self.set_default(limit=100)
+        limits.charge_scans(self.world.db, self.ash.id, count=34)
+
+        mine = self.get("/api/scan-limits/me", self.ash).json()
+        settings = self.get("/api/scan-limits/settings", self.oak).json()
+        overview = self.get("/api/scan-limits/users", self.oak).json()
+        rows = {row["username"]: row for row in overview["users"]}
+
+        self.assertEqual((mine["used"], mine["remaining"], mine["resets_at"]), (34, 66, "2026-10-10T00:00:00-04:00"))
+        self.assertEqual(
+            (settings["timezone"], settings["utc_offset"], settings["next_reset_at"], settings["seconds_until_reset"]),
+            ("America/Detroit", "-04:00", "2026-10-10T00:00:00-04:00", self.until_midnight),
+        )
+        self.assertEqual((overview["timezone"], rows["ash"]["used"], rows["ash"]["daily_limit"]), ("America/Detroit", 34, 100))
+
