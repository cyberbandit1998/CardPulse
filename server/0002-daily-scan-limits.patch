index 0000000..aae3ba8
--- /dev/null
+++ b/frontend/src/utils/scanLimits.test.js
@@ -0,0 +1,83 @@
+import { describe, expect, it } from 'vitest'
+
+import {
+  MAX_DAILY_SCAN_LIMIT,
+  defaultLimitChange,
+  formatScanUsage,
+  parseScanLimit,
+  startingLimit,
+  utcLabel,
+  zoneLabel,
+} from './scanLimits'
+
+const words = { today: 'today', unlimited: 'Unlimited' }
+
+describe('parseScanLimit', () => {
+  it('accepts whole numbers from 0 to the most the server takes, with or without spaces', () => {
+    expect(parseScanLimit('0')).toBe(0)
+    expect(parseScanLimit(' 25 ')).toBe(25)
+    expect(parseScanLimit('100')).toBe(100)
+    expect(parseScanLimit(String(MAX_DAILY_SCAN_LIMIT))).toBe(MAX_DAILY_SCAN_LIMIT)
+    expect(parseScanLimit(7)).toBe(7)
+  })
+
+  it('refuses everything else', () => {
+    for (const typed of ['', ' ', 'abc', '-1', '2.5', '1e3', '12 3', String(MAX_DAILY_SCAN_LIMIT + 1), null, undefined]) {
+      expect(parseScanLimit(typed), JSON.stringify(typed)).toBeNull()
+    }
+  })
+})
+
+describe('formatScanUsage', () => {
+  it('writes a limited user as used / limit today', () => {
+    expect(formatScanUsage({ used: 34, daily_limit: 100, unlimited: false }, words)).toBe('34 / 100 today')
+    expect(formatScanUsage({ used: 0, daily_limit: 0, unlimited: false }, words)).toBe('0 / 0 today')
+  })
+
+  it('writes an unlimited user with what they used and the word Unlimited, never a number to be used up', () => {
+    expect(formatScanUsage({ used: 12, daily_limit: null, unlimited: true }, words)).toBe('12 today · Unlimited')
+    expect(formatScanUsage({ used: 3, daily_limit: null }, words)).toBe('3 today · Unlimited')
+  })
+
+  it('says nothing for a user the server sent nothing about', () => {
+    expect(formatScanUsage(undefined, words)).toBe('')
+  })
+})
+
+describe('startingLimit', () => {
+  it("starts from the user's own number, then the limit that applies, then the suggestion", () => {
+    expect(startingLimit({ custom_limit: 8, daily_limit: 100 })).toBe('8')
+    expect(startingLimit({ custom_limit: null, daily_limit: 100 })).toBe('100')
+    expect(startingLimit({ custom_limit: null, daily_limit: null })).toBe('100')
+    expect(startingLimit(undefined)).toBe('100')
+    expect(startingLimit({ custom_limit: 0, daily_limit: 5 })).toBe('0')
+  })
+})
+
+describe('the reset', () => {
+  it('writes the offset next to the zone', () => {
+    expect(utcLabel('+02:00')).toBe('UTC+02:00')
+    expect(utcLabel('')).toBe('')
+    expect(zoneLabel({ timezone: 'Europe/Berlin', utc_offset: '+02:00' })).toBe('Europe/Berlin (UTC+02:00)')
+    expect(zoneLabel({ timezone: 'UTC' })).toBe('UTC')
+    expect(zoneLabel({})).toBe('')
+  })
+})
+
+describe('defaultLimitChange', () => {
+  const current = { default_unlimited: true, default_limit: 100 }
+
+  it('sends nothing when nothing changed', () => {
+    expect(defaultLimitChange(current, { unlimited: true, limit: 100 })).toEqual({})
+  })
+
+  it('sends only what changed, so saving the number never flips the switch', () => {
+    expect(defaultLimitChange(current, { unlimited: true, limit: 40 })).toEqual({ default_limit: 40 })
+    expect(defaultLimitChange(current, { unlimited: false, limit: 100 })).toEqual({ default_unlimited: false })
+    expect(defaultLimitChange(current, { unlimited: false, limit: 40 })).toEqual({ default_unlimited: false, default_limit: 40 })
+  })
+
+  it('keeps a number that is not a number out of the change', () => {
+    expect(defaultLimitChange(current, { unlimited: true, limit: null })).toEqual({})
+  })
+})
