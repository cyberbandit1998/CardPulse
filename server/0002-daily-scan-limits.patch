+def jpeg_bytes():
+    image = Image.new("RGB", (80, 112), "#d92828")
+    output = io.BytesIO()
+    image.save(output, format="JPEG")
+    return output.getvalue()
+
+
+def provider_double(*, key="a-key", requires_key=True, is_gemini=True):
+    """A stand-in for the vision provider that records whether the model was asked."""
+    provider = Mock()
+    provider.name = "gemini" if is_gemini else "openai"
+    provider.is_gemini = is_gemini
+    provider.model.return_value = "vision-model"
+    provider.credential.return_value = key
+    provider.requires_credential.return_value = requires_key
+    provider.missing_credential_message.return_value = "Add your API key in Settings."
+    provider.generate_text = AsyncMock(return_value=('{"name": "Pikachu", "language": "en"}', None))
+    provider.rate_limit_scope.side_effect = lambda _priority: contextlib.nullcontext()
+    return provider
