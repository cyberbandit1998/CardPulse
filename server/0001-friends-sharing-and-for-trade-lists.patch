+    def test_they_have_and_you_want_when_both_halves_are_shared(self):
+        self.world.share(self.misty, wishlist="friends", trade="friends")
+        match = self.match(self.ash, self.misty)
+        # Of misty's two For Trade cards only the illustration rare is on ash's wishlist.
+        self.assertEqual(self.names(match["they_have_you_want"]), [("Charizard ex", "sv3-223_en", 1, 1)])
+        # Of ash's, both are on misty's wishlist. Quantities: copies offered, copies wanted.
+        self.assertEqual(self.names(match["you_have_they_want"]), [
+            ("Charizard ex", "sv3-125_en", 1, 1),
+            ("Sprigatito", "sv1-1_en", 2, 1),
+        ])
+        self.assertEqual((match["can_see_their_trade_list"], match["can_see_their_wishlist"]), (True, True))
+        self.assertEqual(match["user"]["username"], "misty")
