diff --git a/backend/api/friends.py b/backend/api/friends.py
new file mode 100644
index 0000000..bdbaad0
--- /dev/null
+++ b/backend/api/friends.py
@@ -0,0 +1,489 @@
+"""Friends, sharing and trading between the users of one server.
+
+Every rule about who may see what is in services/friends.py; this module only turns requests into calls to it and rows into
+responses. A response never carries more than the projection described there: purchase prices, added dates, photos, price
+alerts and custom cards stay with their owner.
+
+Nothing is shared until its owner chooses (docs/FRIENDS.md). Sharing is checked here, on the server, for every request: a
+client that hides a tab it was not allowed to open gets no more than one that asks for it anyway.
+"""
+
+import datetime
+from typing import List, Literal, Optional
+
+from fastapi import APIRouter, Depends, HTTPException, Response
+from pydantic import BaseModel, ConfigDict, Field, model_validator
+from sqlalchemy.orm import Session
+
+from api.auth import get_current_user, multi_user_enabled
+from api.social import _card_payload
+from database import get_db
+from models import FriendLink, User
+from schemas import CardWithSet
+from services import friends as fr
+
+SharingLevel = Literal["private", "friends", "public"]
+
+
+def _private_response(response: Response) -> None:
+    """These responses are one person's data: a shared cache must not keep them."""
+    response.headers["Cache-Control"] = "private, no-store"
+
+
+router = APIRouter(dependencies=[Depends(_private_response)])
+
+
+def get_social_user(current_user: User = Depends(get_current_user), db: Session = Depends(get_db)) -> User:
+    """The signed-in user, once the server is known to ask everyone to sign in.
+
+    With multi-user mode off nobody has to, and a request without a token acts as the admin. Friends and sharing mean nothing
+    there, and must not let an anonymous visitor see what friends of the admin have shared.
+    """
+    if not multi_user_enabled(db):
+        raise HTTPException(
+            status_code=403,
+            detail="Friends needs multi-user mode. With it off nobody has to sign in, so nothing can be kept private.",
+        )
+    return current_user
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Response shapes
+# ---------------------------------------------------------------------------------------------------------------------
+
+class PersonOut(BaseModel):
+    id: int
+    username: str
+    avatar_id: Optional[int] = None
+
+
+class SharingOut(BaseModel):
+    """What the user shares, section by section."""
+
+    collection: SharingLevel = "private"
+    wishlist: SharingLevel = "private"
+    trade: SharingLevel = "private"
+
+
+class SharedFlags(BaseModel):
+    """Which sections of another person the signed-in user may see."""
+
+    collection: bool = False
+    wishlist: bool = False
+    trade: bool = False
+
+
+class CountsOut(BaseModel):
+    friends: int = 0
+    incoming: int = 0
+    outgoing: int = 0
+    for_trade_cards: int = 0
+
+
+class MeOut(BaseModel):
+    """The signed-in user's side of Friends. Asking for it is also how a client learns the server has Friends at all."""
+
+    version: int = 1
+    user: PersonOut
+    invite_code: str
+    sharing: SharingOut
+    counts: CountsOut
+
+
+class FriendOut(PersonOut):
+    since: Optional[datetime.datetime] = None
+    # What this friend lets the signed-in user see.
+    shares: SharedFlags
+
+
+class RequestOut(BaseModel):
+    id: int
+    # The other person: the one who asked, for an incoming request; the one who was asked, for an outgoing one.
+    user: PersonOut
+    created_at: Optional[datetime.datetime] = None
+
+
+class OverviewOut(BaseModel):
+    friends: List[FriendOut]
+    incoming: List[RequestOut]
+    outgoing: List[RequestOut]
+
+
+class RequestResult(BaseModel):
+    # "pending": waiting for the other person to answer. "accepted": they had asked first, so you are friends now.
+    status: Literal["pending", "accepted"]
+    request_id: int
+    user: PersonOut
+
+
+class ProfileRequestOut(BaseModel):
+    id: int
+    direction: Literal["incoming", "outgoing"]
+
+
+class ProfileOut(BaseModel):
+    user: PersonOut
+    is_friend: bool
+    request: Optional[ProfileRequestOut] = None
+    shared: SharedFlags
+
+
+class SharedCard(CardWithSet):
+    """A catalogue card as another person sees it: the catalogue's own data and prices, nothing the owner added."""
+
+    has_custom_image_fallback: bool = False
+
+
+class SharedCollectionItem(BaseModel):
+    id: int
+    card_id: str
+    quantity: int
+    condition: str = "NM"
+    variant: str = "Normal"
+    lang: str = "en"
+    # How many of the copies are For Trade. Left out (null) when the owner does not share their For Trade list with the viewer.
+    for_trade_quantity: Optional[int] = None
+    card: Optional[SharedCard] = None
+
+
+class SharedTradeItem(BaseModel):
+    id: int
+    card_id: str
+    # How many copies are For Trade.
+    quantity: int
+    condition: str = "NM"
+    variant: str = "Normal"
+    lang: str = "en"
+    card: Optional[SharedCard] = None
+
+
+class SharedWishlistItem(BaseModel):
+    id: int
+    card_id: str
+    quantity: int = 1
+    created_at: Optional[datetime.datetime] = None
+    card: Optional[SharedCard] = None
+
+
+class TradeMatchRow(SharedTradeItem):
+    # How many copies the other side wants.
+    wanted_quantity: int = 1
+
+
+class TradeMatchOut(BaseModel):
+    user: PersonOut
+    # Their For Trade cards that are on your wishlist.
+    they_have_you_want: List[TradeMatchRow]
+    # Your For Trade cards that are on their wishlist.
+    you_have_they_want: List[TradeMatchRow]
+    # A half can only be worked out when the other person shares what it is built from.
+    can_see_their_trade_list: bool
+    can_see_their_wishlist: bool
+
+
+class OwnTradeEntry(BaseModel):
+    collection_item_id: int
+    quantity: int
+    owned: int
+
+
+class OwnTradeList(BaseModel):
+    items: List[OwnTradeEntry]
+
+
+class OkOut(BaseModel):
+    ok: bool = True
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Request bodies
+# ---------------------------------------------------------------------------------------------------------------------
+
+class SharingUpdate(BaseModel):
+    """Changes the sections it names and leaves the others as they are. A section it does not know is an error."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    collection: Optional[SharingLevel] = None
+    wishlist: Optional[SharingLevel] = None
+    trade: Optional[SharingLevel] = None
+
+
+class FriendRequestCreate(BaseModel):
+    """Who to ask: a username or an invite code, not both."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    username: Optional[str] = Field(default=None, max_length=100)
+    invite_code: Optional[str] = Field(default=None, max_length=40)
+
+    @model_validator(mode="after")
+    def exactly_one(self):
+        if bool((self.username or "").strip()) == bool((self.invite_code or "").strip()):
+            raise ValueError("Send either a username or an invite code")
+        return self
+
+
+class TradeQuantity(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    quantity: int = Field(ge=0, le=999)
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Builders
+# ---------------------------------------------------------------------------------------------------------------------
+
+def _person(user: User) -> dict:
+    return {"id": user.id, "username": user.username, "avatar_id": user.avatar_id}
+
+
+def _friend_out(link: FriendLink, user: User, flags: dict) -> dict:
+    return {**_person(user), "since": link.accepted_at, "shares": flags}
+
+
+def _request_out(link: FriendLink, user: User) -> dict:
+    return {"id": link.id, "user": _person(user), "created_at": link.created_at}
+
+
+def _trade_row(row, count: int, **extra) -> dict:
+    return {
+        "id": row.id,
+        "card_id": row.card_id,
+        "quantity": count,
+        "condition": row.condition or "NM",
+        "variant": row.variant or "Normal",
+        "lang": row.lang or "en",
+        "card": _card_payload(row.card),
+        **extra,
+    }
+
+
+def _flags_for(db: Session, viewer_id: int, users: list[User]) -> dict[int, dict]:
+    levels = fr.sharing_levels_for(db, [user.id for user in users])
+    return {user.id: fr.can_view_levels(db, viewer_id, user.id, levels[user.id]) for user in users}
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# You: your invite code and what you share
+# ---------------------------------------------------------------------------------------------------------------------
+
+@router.get("/me", response_model=MeOut)
+def get_me(current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Your invite code, what you share, and how many friends, requests and For Trade cards you have."""
+    settings = fr.ensure_settings(db, current_user.id)
+    links = fr.links_of(db, current_user.id)
+    counts = {
+        "friends": sum(1 for link, _ in links if link.status == "accepted"),
+        "incoming": sum(1 for link, _ in links if link.status == "pending" and link.requested_by_id != current_user.id),
+        "outgoing": sum(1 for link, _ in links if link.status == "pending" and link.requested_by_id == current_user.id),
+        "for_trade_cards": sum(marked for _, marked, _ in fr.own_trade_list(db, current_user.id)),
+    }
+    return {
+        "user": _person(current_user),
+        "invite_code": fr.format_invite_code(settings.invite_code),
+        "sharing": fr.sharing_levels(settings),
+        "counts": counts,
+    }
+
+
+@router.put("/me/sharing", response_model=SharingOut)
+def update_sharing(update: SharingUpdate, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Chooses who can see your collection, your wishlist and your For Trade list: private, friends or public."""
+    changes = {section: level for section, level in update.model_dump().items() if level is not None}
+    return fr.sharing_levels(fr.update_sharing(db, current_user.id, changes))
+
+
+@router.post("/me/invite-code")
+def new_invite_code(current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Gives you a new invite code. The old one stops working at once. Friends you already have are not affected."""
+    settings = fr.regenerate_invite_code(db, current_user.id)
+    return {"invite_code": fr.format_invite_code(settings.invite_code)}
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Friends and requests
+# ---------------------------------------------------------------------------------------------------------------------
+
+@router.get("/", response_model=OverviewOut)
+def get_friends(current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Your friends (with what each lets you see) and the requests waiting, in and out."""
+    links = fr.links_of(db, current_user.id)
+    accepted = [(link, user) for link, user in links if link.status == "accepted"]
+    flags = _flags_for(db, current_user.id, [user for _, user in accepted])
+    friends = sorted(
+        (_friend_out(link, user, flags[user.id]) for link, user in accepted),
+        key=lambda friend: friend["username"].lower(),
+    )
+    pending = [(link, user) for link, user in links if link.status == "pending"]
+    return {
+        "friends": friends,
+        "incoming": [_request_out(link, user) for link, user in pending if link.requested_by_id != current_user.id],
+        "outgoing": [_request_out(link, user) for link, user in pending if link.requested_by_id == current_user.id],
+    }
+
+
+@router.post("/requests", response_model=RequestResult)
+def send_friend_request(body: FriendRequestCreate, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Asks someone to be your friend, by username or by invite code. They have to accept: a request shares nothing."""
+    if (body.username or "").strip():
+        target = fr.find_user_by_username(db, body.username)
+    else:
+        target = fr.find_user_by_invite_code(db, body.invite_code)
+    link, accepted = fr.send_request(db, current_user, target)
+    return {"status": "accepted" if accepted else "pending", "request_id": link.id, "user": _person(target)}
+
+
+@router.post("/requests/{request_id}/accept", response_model=FriendOut)
+def accept_friend_request(request_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Accepts a request someone made to you. Being friends shares nothing by itself: each of you still chooses."""
+    link = fr.accept_request(db, current_user, request_id)
+    other = fr.active_user(db, fr.other_party(link, current_user.id))
+    if other is None:
+        raise HTTPException(status_code=404, detail="Request not found")
+    return _friend_out(link, other, _flags_for(db, current_user.id, [other])[other.id])
+
+
+@router.post("/requests/{request_id}/decline", response_model=OkOut)
+def decline_friend_request(request_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Declines a request someone made to you. They are not told; their request just goes away."""
+    fr.decline_request(db, current_user, request_id)
+    return {"ok": True}
+
+
+@router.delete("/requests/{request_id}", response_model=OkOut)
+def cancel_friend_request(request_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Takes back a request you made that has not been answered."""
+    fr.cancel_request(db, current_user, request_id)
+    return {"ok": True}
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Your For Trade list
+# ---------------------------------------------------------------------------------------------------------------------
+
+@router.get("/trade-list", response_model=OwnTradeList)
+def get_own_trade_list(current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """The collection rows you have marked For Trade, and how many copies of each."""
+    return {
+        "items": [
+            {"collection_item_id": item_id, "quantity": marked, "owned": held}
+            for item_id, marked, held in fr.own_trade_list(db, current_user.id)
+        ]
+    }
+
+
+@router.put("/trade-list/{item_id}", response_model=OwnTradeEntry)
+def set_trade_quantity(item_id: int, body: TradeQuantity, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Marks some of the copies in one of your collection rows For Trade (0 takes the row off the list).
+
+    Nothing is marked for you: a row with duplicates is not offered until you say how many copies you will trade.
+    """
+    marked, held = fr.set_trade_quantity(db, current_user, item_id, body.quantity)
+    return {"collection_item_id": item_id, "quantity": marked, "owned": held}
+
+
+@router.delete("/trade-list/{item_id}", response_model=OwnTradeEntry)
+def remove_from_trade_list(item_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Takes a collection row off your For Trade list."""
+    marked, held = fr.set_trade_quantity(db, current_user, item_id, 0)
+    return {"collection_item_id": item_id, "quantity": marked, "owned": held}
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Another person
+# ---------------------------------------------------------------------------------------------------------------------
+
+@router.get("/{user_id}/profile", response_model=ProfileOut)
+def get_profile(user_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Who someone is to you, and which of their sections you may open."""
+    owner = fr.active_user(db, user_id)
+    if owner is None:
+        raise HTTPException(status_code=404, detail="User not found")
+    flags = _flags_for(db, current_user.id, [owner])[owner.id]
+    link = fr.link_between(db, current_user.id, owner.id) if owner.id != current_user.id else None
+    if owner.id != current_user.id and link is None and not any(flags.values()):
+        raise HTTPException(status_code=404, detail="User not found")
+    request = None
+    if link is not None and link.status == "pending":
+        request = {"id": link.id, "direction": "outgoing" if link.requested_by_id == current_user.id else "incoming"}
+    return {
+        "user": _person(owner),
+        "is_friend": link is not None and link.status == "accepted",
+        "request": request,
+        "shared": flags,
+    }
+
+
+@router.get("/{user_id}/collection", response_model=List[SharedCollectionItem])
+def get_friend_collection(user_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """What someone shares of their collection: cards, copies, condition, variant, language. Never what they paid."""
+    owner = fr.require_view(db, current_user, user_id, "collection")
+    # Which copies are For Trade is part of the For Trade list, which is shared (or not) on its own.
+    include_trade = fr.can_view(db, current_user.id, owner.id, "trade")
+    return [
+        {
+            "id": row.id,
+            "card_id": row.card_id,
+            "quantity": row.quantity,
+            "condition": row.condition or "NM",
+            "variant": row.variant or "Normal",
+            "lang": row.lang or "en",
+            "for_trade_quantity": count if include_trade else None,
+            "card": _card_payload(row.card),
+        }
+        for row, count in fr.shared_collection(db, owner.id, include_trade)
+    ]
+
+
+@router.get("/{user_id}/wishlist", response_model=List[SharedWishlistItem])
+def get_friend_wishlist(user_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """What someone shares of their wishlist. Their target prices and alerts are never part of it."""
+    owner = fr.require_view(db, current_user, user_id, "wishlist")
+    return [
+        {
+            "id": item.id,
+            "card_id": item.card_id,
+            "quantity": item.quantity or 1,
+            "created_at": item.created_at,
+            "card": _card_payload(item.card),
+        }
+        for item in fr.shared_wishlist(db, owner.id)
+    ]
+
+
+@router.get("/{user_id}/trade-list", response_model=List[SharedTradeItem])
+def get_friend_trade_list(user_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """The cards someone has marked For Trade, and how many copies of each."""
+    owner = fr.require_view(db, current_user, user_id, "trade")
+    return [_trade_row(row, count) for row, count in fr.shared_trade_list(db, owner.id)]
+
+
+@router.get("/{user_id}/trade-match", response_model=TradeMatchOut)
+def get_trade_match(user_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Compares you with one person: what they have that you want, and what you have that they want.
+
+    Each half is built only from what they share with you: their For Trade list for the first, their wishlist for the second.
+    """
+    if user_id == current_user.id:
+        raise HTTPException(status_code=400, detail="You can't compare with yourself")
+    owner = fr.active_user(db, user_id)
+    if owner is None:
+        raise HTTPException(status_code=404, detail="User not found")
+    match = fr.trade_match(db, current_user.id, owner.id)
+    if not (match.can_see_their_trade_list or match.can_see_their_wishlist) and not fr.are_friends(db, current_user.id, owner.id):
+        raise HTTPException(status_code=404, detail="User not found")
+    return {
+        "user": _person(owner),
+        "they_have_you_want": [_trade_row(row, count, wanted_quantity=wanted) for row, count, wanted in match.they_have_you_want],
+        "you_have_they_want": [_trade_row(row, count, wanted_quantity=wanted) for row, count, wanted in match.you_have_they_want],
+        "can_see_their_trade_list": match.can_see_their_trade_list,
+        "can_see_their_wishlist": match.can_see_their_wishlist,
+    }
+
+
+@router.delete("/{friend_id}", response_model=OkOut)
+def remove_friend(friend_id: int, current_user: User = Depends(get_social_user), db: Session = Depends(get_db)):
+    """Ends a friendship. Anything you or they shared with friends only stops being shared at once."""
+    fr.remove_friend(db, current_user, friend_id)
+    return {"ok": True}
