+        for side in ("user_a", "user_b"):
+            self.assertEqual(self.PRIVATE_FIGURES & set(result[side]), set(), side)
+            self.assertIn("total_value", result[side])
+        self.assertEqual(self.PRIVATE_FIGURES & keys_in(result), set())
