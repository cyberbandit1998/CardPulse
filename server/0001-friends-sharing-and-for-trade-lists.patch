+"""A small world for the Friends tests: a catalogue, five people and what each of them owns and wants.
+
+    ash    the owner whose data most tests look at
+    misty  ash's friend (an accepted friendship)
+    brock  a stranger: signed in, no link to anyone
+    gary   has asked ash to be friends; ash has not answered
+    oak    an admin who is not anyone's friend
+
+Nobody shares anything until a test says so (``world.share(...)``), because that is what a fresh install does.
+"""
+
+import datetime
+import os
+
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+from sqlalchemy.pool import StaticPool
+
+from database import Base
+from models import (
+    Card,
+    CollectionItem,
+    FriendLink,
+    FriendSettings,
+    Set,
+    TradeListEntry,
+    User,
+    WishlistItem,
+)
+
+NOW = datetime.datetime(2026, 10, 1, 12, 0, 0)
+
+
+class FriendsWorld:
+    def __init__(self):
+        # SQLite in memory by default. Point FRIENDS_TEST_DATABASE_URL at an empty PostgreSQL database to run the same tests
+        # on the database the server really uses; its tables are dropped when each test ends.
+        database_url = os.environ.get("FRIENDS_TEST_DATABASE_URL", "sqlite:///:memory:")
+        options = {"connect_args": {"check_same_thread": False}, "poolclass": StaticPool} if database_url.startswith("sqlite") else {}
+        self.engine = create_engine(database_url, **options)
+        Base.metadata.create_all(self.engine)
+        self.session_factory = sessionmaker(bind=self.engine, autoflush=False)
+        self.db = self.session_factory()
+        self._people()
+        self._catalogue()
+        self._collections()
+
+    def close(self):
+        self.db.close()
+        Base.metadata.drop_all(self.engine)
+        self.engine.dispose()
+
+    # --- people -------------------------------------------------------------------------------------------------------
+
+    def _people(self):
+        def person(name, role="trainer", **extra):
+            user = User(username=name, hashed_password="x", role=role, is_active=True, **extra)
+            self.db.add(user)
+            return user
+
+        self.ash = person("ash", avatar_id=25)
+        self.misty = person("misty", avatar_id=121)
+        self.brock = person("brock", avatar_id=95)
+        self.gary = person("gary")
+        self.oak = person("oak", role="admin")
+        self.db.commit()
+        self.befriend(self.ash, self.misty)
+        self.request(self.gary, self.ash)
+
+    def befriend(self, a, b, requested_by=None):
+        low, high = sorted((a.id, b.id))
+        link = FriendLink(
+            user_low_id=low,
+            user_high_id=high,
+            requested_by_id=(requested_by or a).id,
+            status="accepted",
+            created_at=NOW,
+            accepted_at=NOW,
+        )
+        self.db.add(link)
+        self.db.commit()
+        return link
+
+    def request(self, sender, target):
+        low, high = sorted((sender.id, target.id))
+        link = FriendLink(
+            user_low_id=low, user_high_id=high, requested_by_id=sender.id, status="pending", created_at=NOW
+        )
+        self.db.add(link)
+        self.db.commit()
+        return link
+
+    def share(self, user, collection=None, wishlist=None, trade=None):
+        settings = self.db.query(FriendSettings).filter(FriendSettings.user_id == user.id).first()
+        if settings is None:
+            settings = FriendSettings(user_id=user.id)
+            self.db.add(settings)
+        if collection is not None:
+            settings.collection_sharing = collection
+        if wishlist is not None:
+            settings.wishlist_sharing = wishlist
+        if trade is not None:
+            settings.trade_sharing = trade
+        self.db.commit()
+        return settings
+
+    # --- catalogue ----------------------------------------------------------------------------------------------------
+
+    def _catalogue(self):
+        self.db.add_all([
+            Set(id="sv1_en", tcg_set_id="sv1", name="Scarlet & Violet", lang="en", total=198, abbreviation="SVI"),
+            Set(id="sv3_en", tcg_set_id="sv3", name="Obsidian Flames", lang="en", total=197, abbreviation="OBF"),
+        ])
+
+        def card(card_id, name, set_id, number, rarity, trend):
+            self.db.add(Card(
+                id=card_id, tcg_card_id=card_id.rsplit("_", 1)[0], name=name, set_id=set_id, number=number,
+                rarity=rarity, lang="en", supertype="Pokémon", price_trend=trend, price_market=trend,
+                images_small=f"https://img.example/{card_id}/low.webp", is_custom=False, is_digital=False,
+                variants_normal=True, variants_holo=True,
+            ))
+
+        card("sv1-1_en", "Sprigatito", "sv1", "1", "Common", 0.5)
+        card("sv1-2_en", "Floragato", "sv1", "2", "Uncommon", 0.8)
+        card("sv1-3_en", "Meowscarada ex", "sv1", "3", "Double Rare", 4.0)
+        card("sv3-125_en", "Charizard ex", "sv3", "125", "Double Rare", 8.5)
+        card("sv3-223_en", "Charizard ex", "sv3", "223", "Special Illustration Rare", 61.0)
+        self.db.commit()
+        # A card ash made by hand: it belongs to ash and must never be shown to anyone else.
+        self.db.add(Card(
+            id="custom-1", name="Private proxy", set_id="custom", number="1", lang="en", is_custom=True,
+            custom_owner_id=self.ash.id, custom_image_url="https://private.example/proxy.png",
+        ))
+        self.db.commit()
+
+    # --- collections --------------------------------------------------------------------------------------------------
+
+    def _collections(self):
+        def own(user, card_id, quantity, condition="NM", variant="Normal", paid=None, minutes=0):
+            row = CollectionItem(
+                user_id=user.id, card_id=card_id, quantity=quantity, condition=condition, variant=variant,
+                purchase_price=paid, lang="en", added_at=NOW + datetime.timedelta(minutes=minutes),
+            )
+            self.db.add(row)
+            self.db.commit()
+            return row
+
+        def want(user, card_id, quantity=1, below=None, minutes=0):
+            item = WishlistItem(
+                user_id=user.id, card_id=card_id, quantity=quantity, price_alert_below=below,
+                price_alert_above=None, created_at=NOW + datetime.timedelta(minutes=minutes),
+            )
+            self.db.add(item)
+            self.db.commit()
+            return item
+
+        # ash: three Sprigatito (NM), a holo one, two Charizard ex, a Meowscarada ex, and the proxy. Paid prices are private.
+        self.ash_sprigatito = own(self.ash, "sv1-1_en", 3, paid=0.2, minutes=1)
+        self.ash_sprigatito_holo = own(self.ash, "sv1-1_en", 1, variant="Holo", paid=1.0, minutes=2)
+        self.ash_charizard = own(self.ash, "sv3-125_en", 2, condition="LP", paid=7.0, minutes=3)
+        self.ash_meowscarada = own(self.ash, "sv1-3_en", 1, paid=3.5, minutes=4)
+        self.ash_proxy = own(self.ash, "custom-1", 1, paid=0.0, minutes=5)
+        # ash wants the Charizard illustration rare (with a secret target price), two Floragato and (oddly) his own proxy.
+        self.ash_wants_sir = want(self.ash, "sv3-223_en", 1, below=50.0, minutes=1)
