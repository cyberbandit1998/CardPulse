+def keys_in(value):
+    """Every dictionary key anywhere in a JSON-like value."""
+    found = set()
+    if isinstance(value, dict):
+        for key, inner in value.items():
+            found.add(key)
+            found |= keys_in(inner)
+    elif isinstance(value, (list, tuple)):
+        for inner in value:
+            found |= keys_in(inner)
+    return found
