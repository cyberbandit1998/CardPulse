+++ b/backend/services/friends.py
@@ -0,0 +1,591 @@
+"""Friends, sharing and the For Trade list.
+
+Everything that decides who may see what lives here, so that the friends router and the few older endpoints that show one
+user's data to another ask one place, instead of each having its own idea of "shared".
+
+The rules
+---------
+* A user has three sections that can be shared: the full collection, the wishlist and the For Trade list. Each has its own
+  setting - private, friends or public - and a user who has never chosen shares nothing.
+* "friends" means an accepted FriendLink. A request that has not been accepted grants nothing. "public" means every signed-in
+  user of this server, not the open internet.
+* The owner always sees their own data. Nobody else does unless the setting allows it, whatever their role: an admin gets no
+  special view through these functions.
+* What other people receive is a projection: the card, how many copies, condition, variant and language. Purchase prices,
+  added dates, photos, product links, price alerts and custom cards never leave their owner.
+* Nothing goes on the For Trade list by itself. A copy is marked by its owner, one collection row at a time.
+"""
+
+import datetime
+import re
+import secrets
+from dataclasses import dataclass, field
+
+from fastapi import HTTPException
+from sqlalchemy import func, or_
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import Session, joinedload
+
+from models import (
+    FRIEND_SHARING_LEVELS,
+    Card,
+    CollectionItem,
+    FriendLink,
+    FriendSettings,
+    TradeListEntry,
+    User,
+    WishlistItem,
+)
+from services.card_visibility import visible_card_filter
+
+SECTIONS = ("collection", "wishlist", "trade")
+
+# The words used when a person is told something is not shared with them.
+SECTION_NAMES = {"collection": "collection", "wishlist": "wishlist", "trade": "For Trade list"}
+
+_SECTION_COLUMNS = {
+    "collection": FriendSettings.collection_sharing,
+    "wishlist": FriendSettings.wishlist_sharing,
+    "trade": FriendSettings.trade_sharing,
+}
+_SECTION_ATTRIBUTES = {
+    "collection": "collection_sharing",
+    "wishlist": "wishlist_sharing",
+    "trade": "trade_sharing",
+}
+
+# No I, L, O or U, and no 0 or 1: a code read aloud or typed from a photo cannot be mistaken for another one.
+INVITE_ALPHABET = "ABCDEFGHJKMNPQRSTVWXYZ23456789"
+INVITE_LENGTH = 10
+# Enough that nobody has to wait on a request, few enough that nobody can flood the server with them.
+MAX_PENDING_OUTGOING = 25
+MAX_USERNAME_LENGTH = 64
+
+_ALPHANUMERIC = re.compile(r"[^A-Za-z0-9]")
+
+
+def _now() -> datetime.datetime:
+    return datetime.datetime.utcnow()
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Invite codes
+# ---------------------------------------------------------------------------------------------------------------------
+
+def normalize_invite_code(raw: str | None) -> str | None:
+    """The code as stored (ten capital letters and digits), or None when what was typed cannot be a code."""
+    code = _ALPHANUMERIC.sub("", raw or "").upper()
+    if len(code) != INVITE_LENGTH or any(char not in INVITE_ALPHABET for char in code):
+        return None
+    return code
+
+
+def format_invite_code(code: str | None) -> str | None:
+    """The code as people write it: two groups of five, such as K7MQ9-XWD3H."""
+    if not code:
+        return None
+    half = INVITE_LENGTH // 2
+    return f"{code[:half]}-{code[half:]}"
+
+
+def _new_invite_code(db: Session) -> str:
+    for _ in range(20):
+        code = "".join(secrets.choice(INVITE_ALPHABET) for _ in range(INVITE_LENGTH))
+        if not db.query(FriendSettings.user_id).filter(FriendSettings.invite_code == code).first():
+            return code
+    raise HTTPException(status_code=500, detail="Could not make an invite code")
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Users
+# ---------------------------------------------------------------------------------------------------------------------
+
+def active_user(db: Session, user_id: int) -> User | None:
+    return db.query(User).filter(User.id == user_id, User.is_active == True).first()  # noqa: E712
+
+
+def find_user_by_username(db: Session, raw: str | None) -> User:
+    name = (raw or "").strip()
+    if not name:
+        raise HTTPException(status_code=422, detail="Type a username")
+    if len(name) > MAX_USERNAME_LENGTH:
+        raise HTTPException(status_code=404, detail="Nobody on this server has that username")
+    exact = db.query(User).filter(User.username == name, User.is_active == True).first()  # noqa: E712
+    if exact:
+        return exact
+    loose = db.query(User).filter(func.lower(User.username) == name.lower(), User.is_active == True).all()  # noqa: E712
+    if len(loose) == 1:
+        return loose[0]
+    if len(loose) > 1:
+        raise HTTPException(status_code=409, detail="More than one person has almost that username. Type it exactly as it is spelled.")
+    raise HTTPException(status_code=404, detail="Nobody on this server has that username")
+
+
+def find_user_by_invite_code(db: Session, raw: str | None) -> User:
+    code = normalize_invite_code(raw)
+    if code is None:
+        raise HTTPException(status_code=422, detail="That doesn't look like an invite code")
+    settings = db.query(FriendSettings).filter(FriendSettings.invite_code == code).first()
+    user = active_user(db, settings.user_id) if settings else None
+    if user is None:
+        raise HTTPException(status_code=404, detail="That invite code doesn't match anyone")
+    return user
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# What each person shares
+# ---------------------------------------------------------------------------------------------------------------------
+
+def get_settings(db: Session, user_id: int) -> FriendSettings | None:
+    return db.query(FriendSettings).filter(FriendSettings.user_id == user_id).first()
+
+
+def ensure_settings(db: Session, user_id: int) -> FriendSettings:
+    """The user's settings row, made (with an invite code, sharing nothing) the first time it is needed."""
+    settings = get_settings(db, user_id)
+    if settings is not None and settings.invite_code:
+        return settings
+    if settings is None:
+        settings = FriendSettings(
+            user_id=user_id,
+            collection_sharing="private",
+            wishlist_sharing="private",
+            trade_sharing="private",
+        )
+        db.add(settings)
+    settings.invite_code = _new_invite_code(db)
+    try:
+        db.commit()
+    except IntegrityError:
+        # Another request made the row (or took the code) at the same moment.
+        db.rollback()
+        settings = get_settings(db, user_id)
+        if settings is None or not settings.invite_code:
+            raise HTTPException(status_code=409, detail="Try again") from None
+    return settings
+
+
+def sharing_levels(settings: FriendSettings | None) -> dict[str, str]:
+    """What a user shares, by section. Anything unknown counts as private."""
+    levels = {}
+    for section in SECTIONS:
+        level = getattr(settings, _SECTION_ATTRIBUTES[section], None) if settings is not None else None
+        levels[section] = level if level in FRIEND_SHARING_LEVELS else "private"
+    return levels
+
+
+def sharing_levels_for(db: Session, user_ids: list[int]) -> dict[int, dict[str, str]]:
+    """What each of several users shares, in one query."""
+    if not user_ids:
+        return {}
+    rows = db.query(FriendSettings).filter(FriendSettings.user_id.in_(set(user_ids))).all()
+    by_user = {row.user_id: sharing_levels(row) for row in rows}
+    return {user_id: by_user.get(user_id, sharing_levels(None)) for user_id in user_ids}
+
+
+def update_sharing(db: Session, user_id: int, changes: dict[str, str]) -> FriendSettings:
+    """Applies the sections named in [changes]; the others stay as they are."""
+    settings = ensure_settings(db, user_id)
+    for section, level in changes.items():
+        if section not in SECTIONS or level not in FRIEND_SHARING_LEVELS:
+            raise HTTPException(status_code=422, detail="Sharing must be private, friends or public")
+        setattr(settings, _SECTION_ATTRIBUTES[section], level)
+    db.commit()
+    return settings
+
+
+def regenerate_invite_code(db: Session, user_id: int) -> FriendSettings:
+    """Gives the user a new invite code. The old one stops working at once."""
+    settings = ensure_settings(db, user_id)
+    settings.invite_code = _new_invite_code(db)
+    db.commit()
+    return settings
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Friendships and requests
+# ---------------------------------------------------------------------------------------------------------------------
+
+def _ordered(a: int, b: int) -> tuple[int, int]:
+    return (a, b) if a < b else (b, a)
+
+
+def link_between(db: Session, a: int, b: int) -> FriendLink | None:
+    low, high = _ordered(a, b)
+    return db.query(FriendLink).filter(FriendLink.user_low_id == low, FriendLink.user_high_id == high).first()
+
+
+def other_party(link: FriendLink, me_id: int) -> int:
+    return link.user_high_id if link.user_low_id == me_id else link.user_low_id
+
+
+def accepted_friend_ids(db: Session, user_id: int) -> set[int]:
+    links = db.query(FriendLink).filter(
+        FriendLink.status == "accepted",
+        or_(FriendLink.user_low_id == user_id, FriendLink.user_high_id == user_id),
+    ).all()
+    return {other_party(link, user_id) for link in links}
+
+
+def are_friends(db: Session, a: int, b: int) -> bool:
+    if a == b:
+        return False
+    link = link_between(db, a, b)
+    return link is not None and link.status == "accepted"
+
+
+def links_of(db: Session, user_id: int) -> list[tuple[FriendLink, User]]:
+    """Every friendship and request of a user, newest first, each with the other person. Inactive users are left out."""
+    links = db.query(FriendLink).filter(
+        or_(FriendLink.user_low_id == user_id, FriendLink.user_high_id == user_id),
+    ).order_by(FriendLink.created_at.desc(), FriendLink.id.desc()).all()
+    if not links:
+        return []
+    others = {
+        user.id: user
+        for user in db.query(User).filter(
+            User.id.in_({other_party(link, user_id) for link in links}),
+            User.is_active == True,  # noqa: E712
+        ).all()
+    }
+    return [(link, others[other_party(link, user_id)]) for link in links if other_party(link, user_id) in others]
+
+
+def send_request(db: Session, me: User, target: User) -> tuple[FriendLink, bool]:
+    """Asks [target] to be friends. Returns the link and whether it is now a friendship.
+
+    Asking someone who has already asked you accepts their request, because both of you want it. Asking twice changes nothing.
+    """
+    if target.id == me.id:
+        raise HTTPException(status_code=400, detail="You can't add yourself as a friend")
+    link = link_between(db, me.id, target.id)
+    if link is not None:
+        if link.status == "accepted":
+            raise HTTPException(status_code=409, detail=f"You and {target.username} are already friends")
+        if link.requested_by_id == me.id:
+            return link, False
+        link.status = "accepted"
+        link.accepted_at = _now()
+        db.commit()
+        return link, True
+    waiting = db.query(FriendLink).filter(FriendLink.requested_by_id == me.id, FriendLink.status == "pending").count()
+    if waiting >= MAX_PENDING_OUTGOING:
+        raise HTTPException(status_code=409, detail="You have too many requests waiting. Wait for some to be answered, or cancel a few.")
+    low, high = _ordered(me.id, target.id)
+    link = FriendLink(user_low_id=low, user_high_id=high, requested_by_id=me.id, status="pending", created_at=_now())
+    db.add(link)
+    try:
+        db.commit()
+    except IntegrityError:
+        # The other person asked at the same moment: whatever is there now decides.
+        db.rollback()
+        link = link_between(db, me.id, target.id)
+        if link is None:
+            raise HTTPException(status_code=409, detail="Try again") from None
+        if link.status == "pending" and link.requested_by_id != me.id:
+            link.status = "accepted"
+            link.accepted_at = _now()
+            db.commit()
+            return link, True
+        return link, link.status == "accepted"
+    return link, False
+
+
+def _request_for(db: Session, request_id: int) -> FriendLink:
+    link = db.query(FriendLink).filter(FriendLink.id == request_id).first()
+    if link is None:
+        raise HTTPException(status_code=404, detail="Request not found")
+    return link
+
+
+def accept_request(db: Session, me: User, request_id: int) -> FriendLink:
+    """Accepts a request someone made to [me]. Only the person who was asked can."""
+    link = _request_for(db, request_id)
+    if me.id not in (link.user_low_id, link.user_high_id) or link.requested_by_id == me.id:
+        raise HTTPException(status_code=404, detail="Request not found")
+    if link.status != "accepted":
+        link.status = "accepted"
+        link.accepted_at = _now()
+        db.commit()
+    return link
+
+
+def decline_request(db: Session, me: User, request_id: int) -> None:
+    """Declines a request someone made to [me]. The other person is not told; their request simply goes away."""
+    link = _request_for(db, request_id)
+    if me.id not in (link.user_low_id, link.user_high_id) or link.requested_by_id == me.id:
+        raise HTTPException(status_code=404, detail="Request not found")
+    if link.status != "pending":
+        raise HTTPException(status_code=409, detail="You are already friends. Remove them from your friends instead.")
+    db.delete(link)
+    db.commit()
+
+
+def cancel_request(db: Session, me: User, request_id: int) -> None:
+    """Takes back a request [me] made that has not been answered."""
+    link = _request_for(db, request_id)
+    if link.requested_by_id != me.id:
+        raise HTTPException(status_code=404, detail="Request not found")
+    if link.status != "pending":
+        raise HTTPException(status_code=409, detail="That request was already accepted")
+    db.delete(link)
+    db.commit()
+
+
+def remove_friend(db: Session, me: User, friend_id: int) -> None:
+    """Ends a friendship. Either person can; what was shared with "friends" stops being shared at once."""
+    link = link_between(db, me.id, friend_id)
+    if link is None or link.status != "accepted":
+        raise HTTPException(status_code=404, detail="That person isn't one of your friends")
+    db.delete(link)
+    db.commit()
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Who may see what
+# ---------------------------------------------------------------------------------------------------------------------
+
+def can_view(db: Session, viewer_id: int, owner_id: int, section: str) -> bool:
+    """Whether [viewer] may see [owner]'s [section] ("collection", "wishlist" or "trade")."""
+    if section not in SECTIONS:
+        return False
+    if viewer_id == owner_id:
+        return True
+    level = sharing_levels(get_settings(db, owner_id))[section]
+    if level == "public":
+        return True
+    if level == "friends":
+        return are_friends(db, viewer_id, owner_id)
+    return False
+
+
+def can_view_levels(db: Session, viewer_id: int, owner_id: int, levels: dict[str, str]) -> dict[str, bool]:
+    """can_view for every section at once, given the owner's levels already read."""
+    friend = None
+    result = {}
+    for section in SECTIONS:
+        level = levels[section]
+        if level == "public":
+            result[section] = True
+        elif level == "friends":
+            if friend is None:
+                friend = are_friends(db, viewer_id, owner_id)
+            result[section] = friend
+        else:
+            result[section] = False
+    return result
+
+
+def owners_visible_to(db: Session, viewer_id: int, section: str) -> set[int]:
+    """The ids of everyone whose [section] the viewer may see, the viewer included."""
+    column = _SECTION_COLUMNS[section]
+    rows = db.query(FriendSettings.user_id, column).filter(column.in_(("friends", "public"))).all()
+    friends = accepted_friend_ids(db, viewer_id) if any(level == "friends" for _, level in rows) else set()
+    visible = {viewer_id}
+    for user_id, level in rows:
+        if level == "public" or (level == "friends" and user_id in friends):
+            visible.add(user_id)
+    return visible
+
+
+def require_view(db: Session, viewer: User, owner_id: int, section: str) -> User:
+    """The owner, if [viewer] may see their [section]; otherwise an error that tells the viewer no more than they may know.
+
+    A friend is told what is not shared with them. Anyone else is told only that there is no such user, so a person who is not
+    a friend cannot tell a private account from one that does not exist.
+    """
+    owner = active_user(db, owner_id)
+    if owner is None:
+        raise HTTPException(status_code=404, detail="User not found")
+    if can_view(db, viewer.id, owner.id, section):
+        return owner
+    if are_friends(db, viewer.id, owner.id):
+        raise HTTPException(status_code=403, detail=f"{owner.username} hasn't shared their {SECTION_NAMES[section]} with you")
+    raise HTTPException(status_code=404, detail="User not found")
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# What is shared
+# ---------------------------------------------------------------------------------------------------------------------
+
+def _owned_rows(db: Session, owner_id: int):
+    """The owner's collection rows that may be shown to anyone: catalogue cards only, as the older shared endpoints do."""
+    return (
+        db.query(CollectionItem)
+        .join(Card, Card.id == CollectionItem.card_id)
+        .options(joinedload(CollectionItem.card).joinedload(Card.set_ref))
+        .filter(
+            CollectionItem.user_id == owner_id,
+            Card.is_custom == False,  # noqa: E712
+            visible_card_filter(db, owner_id, "all"),
+        )
+    )
+
+
+def trade_quantities(db: Session, owner_id: int) -> dict[int, int]:
+    """Collection row id -> copies marked For Trade, never more than the owner still holds."""
+    rows = (
+        db.query(TradeListEntry.collection_item_id, TradeListEntry.quantity, CollectionItem.quantity)
+        .join(CollectionItem, CollectionItem.id == TradeListEntry.collection_item_id)
+        .filter(TradeListEntry.user_id == owner_id, CollectionItem.user_id == owner_id)
+        .all()
+    )
+    quantities = {}
+    for item_id, marked, held in rows:
+        count = min(int(marked or 0), int(held or 0))
+        if count > 0:
+            quantities[item_id] = count
+    return quantities
+
+
+def shared_collection(db: Session, owner_id: int, include_trade: bool) -> list[tuple[CollectionItem, int]]:
+    """The owner's collection rows, newest first, each with how many copies are For Trade (0 when [include_trade] is off)."""
+    rows = _owned_rows(db, owner_id).order_by(CollectionItem.added_at.desc(), CollectionItem.id.desc()).all()
+    marked = trade_quantities(db, owner_id) if include_trade else {}
+    return [(row, marked.get(row.id, 0)) for row in rows]
+
+
+def shared_trade_list(db: Session, owner_id: int) -> list[tuple[CollectionItem, int]]:
+    """The owner's rows that have copies For Trade, each with how many, in card-name order."""
+    rows = (
+        _owned_rows(db, owner_id)
+        .join(TradeListEntry, TradeListEntry.collection_item_id == CollectionItem.id)
+        .filter(TradeListEntry.user_id == owner_id)
+        .order_by(Card.name.asc(), Card.number.asc(), CollectionItem.id.asc())
+        .all()
+    )
+    marked = trade_quantities(db, owner_id)
+    return [(row, marked[row.id]) for row in rows if row.id in marked]
+
+
+def shared_wishlist(db: Session, owner_id: int) -> list[WishlistItem]:
+    """The owner's wishlist, newest first. Catalogue cards only. The price alerts are never part of it."""
+    return (
+        db.query(WishlistItem)
+        .join(Card, Card.id == WishlistItem.card_id)
+        .options(joinedload(WishlistItem.card).joinedload(Card.set_ref))
+        .filter(
+            WishlistItem.user_id == owner_id,
+            Card.is_custom == False,  # noqa: E712
+            visible_card_filter(db, owner_id, "all"),
+        )
+        .order_by(WishlistItem.created_at.desc(), WishlistItem.id.desc())
+        .all()
+    )
+
+
+@dataclass
+class TradeMatch:
+    """Both halves of a comparison between the viewer and one other person.
+
+    Each half needs the other person to share the section it is built from, so a half the viewer may not see is empty and
+    says so, rather than giving away which of their cards would have matched.
+    """
+
+    they_have_you_want: list[tuple[CollectionItem, int, int]] = field(default_factory=list)
+    you_have_they_want: list[tuple[CollectionItem, int, int]] = field(default_factory=list)
+    can_see_their_trade_list: bool = False
+    can_see_their_wishlist: bool = False
+
+
+def trade_match(db: Session, viewer_id: int, other_id: int) -> TradeMatch:
+    """Each match is (the collection row on offer, how many copies are For Trade, how many the other side wants)."""
+    result = TradeMatch(
+        can_see_their_trade_list=can_view(db, viewer_id, other_id, "trade"),
+        can_see_their_wishlist=can_view(db, viewer_id, other_id, "wishlist"),
+    )
+    if result.can_see_their_trade_list:
+        mine = {item.card_id: item for item in shared_wishlist(db, viewer_id)}
+        if mine:
+            for row, count in shared_trade_list(db, other_id):
+                wanted = mine.get(row.card_id)
+                if wanted is not None:
+                    result.they_have_you_want.append((row, count, int(wanted.quantity or 1)))
+    if result.can_see_their_wishlist:
+        theirs = {item.card_id: item for item in shared_wishlist(db, other_id)}
+        if theirs:
+            for row, count in shared_trade_list(db, viewer_id):
+                wanted = theirs.get(row.card_id)
+                if wanted is not None:
+                    result.you_have_they_want.append((row, count, int(wanted.quantity or 1)))
+    return result
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# The owner's own For Trade list
+# ---------------------------------------------------------------------------------------------------------------------
+
+def normalize_trade_list(db: Session, user_id: int) -> None:
+    """Trims every entry to the copies the owner still holds and drops entries left with none.
+
+    Without this, copies that were marked, then removed, would be marked again the moment the owner added more.
+    """
+    rows = (
+        db.query(TradeListEntry, CollectionItem.quantity)
+        .outerjoin(CollectionItem, CollectionItem.id == TradeListEntry.collection_item_id)
+        .filter(TradeListEntry.user_id == user_id)
+        .all()
+    )
+    changed = False
+    for entry, held in rows:
+        held = int(held or 0)
+        if held <= 0:
+            db.delete(entry)
+            changed = True
+        elif entry.quantity > held:
+            entry.quantity = held
+            changed = True
+    if changed:
+        db.commit()
+
+
+def own_trade_list(db: Session, user_id: int) -> list[tuple[int, int, int]]:
+    """(collection row id, copies For Trade, copies held) for every marked row of the user."""
+    normalize_trade_list(db, user_id)
+    rows = (
+        db.query(TradeListEntry.collection_item_id, TradeListEntry.quantity, CollectionItem.quantity)
+        .join(CollectionItem, CollectionItem.id == TradeListEntry.collection_item_id)
+        .filter(TradeListEntry.user_id == user_id, CollectionItem.user_id == user_id)
+        .order_by(TradeListEntry.id.asc())
+        .all()
+    )
+    return [(item_id, int(marked), int(held or 0)) for item_id, marked, held in rows]
+
+
+def set_trade_quantity(db: Session, user: User, item_id: int, quantity: int) -> tuple[int, int]:
+    """Marks [quantity] copies of one of the user's collection rows For Trade (0 takes it off). Returns (marked, held)."""
+    item = (
+        db.query(CollectionItem)
+        .options(joinedload(CollectionItem.card))
+        .filter(CollectionItem.id == item_id, CollectionItem.user_id == user.id)
+        .first()
+    )
+    if item is None:
+        raise HTTPException(status_code=404, detail="Collection item not found")
+    if item.card is None or item.card.is_custom:
+        raise HTTPException(status_code=422, detail="A custom card can't be put up for trade")
+    held = int(item.quantity or 0)
+    if quantity < 0 or quantity > held:
+        raise HTTPException(status_code=422, detail=f"You only have {held} of this card")
+    entry = db.query(TradeListEntry).filter(TradeListEntry.collection_item_id == item.id).first()
+    if quantity == 0:
+        if entry is not None:
+            db.delete(entry)
+    elif entry is not None:
+        entry.quantity = quantity
+    else:
+        db.add(TradeListEntry(user_id=user.id, collection_item_id=item.id, quantity=quantity, created_at=_now()))
+    try:
+        db.commit()
+    except IntegrityError:
+        # Two requests marked the same row at once: the later one wins.
+        db.rollback()
+        entry = db.query(TradeListEntry).filter(TradeListEntry.collection_item_id == item.id).first()
+        if entry is None:
+            raise HTTPException(status_code=409, detail="Try again") from None
+        if quantity == 0:
+            db.delete(entry)
+        else:
+            entry.quantity = quantity
+        db.commit()
+    return quantity, held
