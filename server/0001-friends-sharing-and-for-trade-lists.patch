@@ -0,0 +1,171 @@
+import { createElement } from 'react'
+import { renderToStaticMarkup } from 'react-dom/server'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { Route, Routes, StaticRouter } from 'react-router-dom'
+import { describe, expect, it, vi } from 'vitest'
+import Compare from './Compare'
+import Leaderboard from './Leaderboard'
+
+vi.mock('../api/client', () => ({
+  getLeaderboard: vi.fn(),
+  compareUsers: vi.fn(),
+}))
+
+vi.mock('../contexts/SettingsContext', () => ({
+  useSettings: () => ({
+    t: key => key,
+    formatPrice: value => `$${Number(value).toFixed(2)}`,
+    pricePrimaryField: 'price_trend',
+  }),
+}))
+
+vi.mock('../contexts/AuthContext', () => ({
+  useAuth: () => ({ multiUser: true, user: { id: 1 } }),
+}))
+
+vi.mock('../components/card-system', () => ({
+  CardIdentity: ({ name, subtext }) => createElement('div', { 'data-best-card': true }, name, ' ', subtext),
+}))
+
+vi.mock('../components/CardItem', () => ({
+  CardModal: () => null,
+}))
+
+// Figures worked out from what someone paid. They are the owner's alone, so neither page may draw them. An older
+// server still sends them, which is why they are fed in here as well as left out.
+const PAID_FIGURES = { total_invested: 4321.98, pnl: 8765.43, pnl_pct: 61.25, positive_pnl_flag: 1 }
+const PAID_FIGURE_TEXT = ['4321.98', '8765.43', '61.25']
+
+const trainer = (overrides = {}) => ({
+  user_id: 2,
+  username: 'misty',
+  avatar_id: 121,
+  role: 'user',
+  total_cards: 321,
+  unique_cards: 200,
+  total_value: 1234.5,
+  most_valuable_card: { card_id: 'base1-4_en', name: 'Charizard', price_market: 250 },
+  sets_completed: 3,
+  set_diversity: 12,
+  wishlist_count: 4,
+  sold_products_count: 0,
+  illustration_rare_flag: 0,
+  public_handle: null,
+  ...overrides,
+})
+
+function renderPage({ location, path, element, queryKey, data }) {
+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+  queryClient.setQueryData(queryKey, data)
+  return renderToStaticMarkup(
+    createElement(
+      QueryClientProvider,
+      { client: queryClient },
+      createElement(
+        StaticRouter,
+        { location },
+        createElement(Routes, null, createElement(Route, { path, element })),
+      ),
+    ),
+  )
+}
+
+const renderLeaderboard = rows => renderPage({
+  location: '/leaderboard',
+  path: '/leaderboard',
+  element: createElement(Leaderboard),
+  queryKey: ['leaderboard', 'price_trend'],
+  data: rows,
+})
+
+const renderCompare = comparison => renderPage({
+  location: '/leaderboard/compare/2',
+  path: '/leaderboard/compare/:userId',
+  element: createElement(Compare),
+  queryKey: ['compare', '2', 'price_trend'],
+  data: comparison,
+})
+
+function expectNothingFromWhatWasPaid(markup) {
+  expect(markup).not.toContain('leaderboard.pnl')
+  expect(markup).not.toContain('P&amp;L')
+  for (const figure of PAID_FIGURE_TEXT) expect(markup).not.toContain(figure)
+  // A profit or a loss is drawn with a sign in front of an amount, and a missing one used to read +$0.00.
+  expect(markup).not.toMatch(/[+-]\$\d/)
+}
+
+describe('Leaderboard page', () => {
+  const sharedRows = [trainer(), trainer({ user_id: 1, username: 'ash', total_value: 900.25, total_cards: 111 })]
+
+  it('has no profit or loss column when the server leaves the figures out', () => {
+    const markup = renderLeaderboard(sharedRows)
+
+    expectNothingFromWhatWasPaid(markup)
+  })
+
+  it('draws nothing from what someone paid even when the server still sends it', () => {
+    const markup = renderLeaderboard(sharedRows.map(row => ({ ...row, ...PAID_FIGURES })))
+
+    expectNothingFromWhatWasPaid(markup)
+  })
+
+  it('keeps the username, avatar, value, card count and best card', () => {
+    const markup = renderLeaderboard(sharedRows)
+
+    expect(markup).toContain('misty')
+    expect(markup).toContain('ash')
+    expect(markup).toContain('/121.gif')
+    expect(markup).toContain('leaderboard.value')
+    expect(markup).toContain('$1234.50')
+    expect(markup).toContain('leaderboard.cards')
+    expect(markup).toContain('321')
+    expect(markup).toContain('leaderboard.bestCard')
+    expect(markup).toContain('Charizard')
+    expect(markup).toContain('$250.00')
+  })
+
+  it('cannot be sorted by profit or loss', () => {
+    const markup = renderLeaderboard(sharedRows)
+    const sortChoices = [...markup.matchAll(/<option value="([^"]+)"/g)].map(match => match[1])
+
+    expect(sortChoices).toEqual(['total_value', 'total_cards', 'unique_cards', 'sets_completed'])
+  })
+})
+
+describe('Compare page', () => {
+  const comparison = (paid = {}) => ({
+    user_a: trainer({ user_id: 1, username: 'ash', total_value: 900.25, total_cards: 111, unique_cards: 90, sets_completed: 1, ...paid }),
+    user_b: trainer({ ...paid }),
+    overlap: 5,
+    only_a: 7,
+    only_b: 9,
+    trade_suggestions: [],
+  })
+
+  it('has no profit or loss block when the server leaves the figures out', () => {
+    const markup = renderCompare(comparison())
+
+    expectNothingFromWhatWasPaid(markup)
+  })
+
+  it('draws nothing from what someone paid even when the server still sends it', () => {
+    const markup = renderCompare(comparison(PAID_FIGURES))
+
+    expectNothingFromWhatWasPaid(markup)
+  })
+
+  it('keeps both trainers, their value, cards, sets and best card', () => {
+    const markup = renderCompare(comparison())
+
+    expect(markup).toContain('ash')
+    expect(markup).toContain('misty')
+    expect(markup).toContain('$900.25')
+    expect(markup).toContain('$1234.50')
+    expect(markup).toContain('leaderboard.cards')
+    expect(markup).toContain('leaderboard.uniqueCards')
+    expect(markup).toContain('leaderboard.setsCompleted')
+    expect(markup).toContain('leaderboard.bestCard')
+    expect(markup).toContain('Charizard')
+    expect(markup).toContain('compare.cardsInCommon')
+  })
+})
