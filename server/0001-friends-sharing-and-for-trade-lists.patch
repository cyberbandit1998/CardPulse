+
+        own = achievements(self.ash)
+        theirs = achievements(self.misty)
+        self.assertIn("investor", [item["id"] for item in own["achievements"]])  # your own list is yours
+        self.assertNotIn("investor", [item["id"] for item in theirs["achievements"]])
+        # Everything else is still there, and the counts agree with the list.
+        self.assertEqual(theirs["total"], len(theirs["achievements"]))
