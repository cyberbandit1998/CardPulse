+    def test_the_leaderboard_is_still_in_order_of_what_the_collections_are_worth(self):
+        self.world.share(self.ash, collection="friends")
+        board = get_leaderboard(price_field="price_trend", db=self.db, current_user=self.misty)
+        values = [entry["total_value"] for entry in board]
+        self.assertEqual(values, sorted(values, reverse=True))
