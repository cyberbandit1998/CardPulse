+    def mark_trade(self, user, row, quantity):
+        entry = self.db.query(TradeListEntry).filter(TradeListEntry.collection_item_id == row.id).first()
+        if entry is None:
+            entry = TradeListEntry(user_id=user.id, collection_item_id=row.id, quantity=quantity, created_at=NOW)
+            self.db.add(entry)
+        else:
+            entry.quantity = quantity
+        self.db.commit()
+        return entry
