+        self.assertEqual({entry["username"] for entry in board}, {"misty", "ash"})
+        for entry in board:  # the viewer's own row too
+            self.assertEqual(self.PRIVATE_FIGURES & set(entry), set(), entry["username"])
+            # What it may still show: who they are, how much they have and what it is worth.
+            for key in ("user_id", "username", "total_cards", "unique_cards", "total_value", "sets_completed", "set_diversity"):
+                self.assertIn(key, entry)
+        self.assertEqual(self.PRIVATE_FIGURES & keys_in(board), set())
